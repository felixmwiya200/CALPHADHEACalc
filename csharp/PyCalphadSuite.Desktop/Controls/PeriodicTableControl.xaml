<UserControl x:Class="PyCalphadSuite.Desktop.Controls.PeriodicTableControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <!-- High-Contrast Reference Chart Element Tile Button Template -->
        <Style x:Key="ElementTileButtonStyle" TargetType="ToggleButton">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="BorderThickness" Value="1.2"/>
            <Setter Property="BorderBrush" Value="#000000"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0.8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="tileBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="0"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="tileBorder" Property="BorderBrush" Value="#000000"/>
                                <Setter TargetName="tileBorder" Property="BorderThickness" Value="2.2"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="tileBorder" Property="BorderBrush" Value="#1D4ED8"/>
                                <Setter TargetName="tileBorder" Property="BorderThickness" Value="3.0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Grid x:Name="RootGrid" Background="#202225">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header & Preset Ribbon -->
        <Border x:Name="HeaderBorder" Grid.Row="0" Background="#2B2D31" BorderBrush="#3F4248" BorderThickness="0,0,0,1" Padding="12,8">
            <DockPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="TxtHeaderTitle" Text="IUPAC 118-Element Periodic Table" FontWeight="Bold" FontSize="14" Foreground="#F2F3F5" VerticalAlignment="Center" Margin="0,0,14,0"/>
                    <TextBox x:Name="TxtFilter" Width="190" Padding="6,3" VerticalAlignment="Center" Background="#202225" Foreground="#F2F3F5" BorderBrush="#3F4248" CaretBrush="#F2F3F5" ToolTip="Filter by element symbol, name, or atomic number Z" TextChanged="TxtFilter_TextChanged"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                    <Button Content="Clear Selection" Click="BtnClear_Click" Padding="10,4" Margin="4,0" Background="#2B2D31" Foreground="#F2F3F5" BorderBrush="#4E5058" BorderThickness="1"/>
                    <Button x:Name="BtnMergeApply" Content="Add to Active Composition" Click="BtnMergeApply_Click" Padding="10,4" Margin="4,0" Background="#2B2D31" Foreground="#F2F3F5" FontWeight="SemiBold" BorderBrush="#4E5058" BorderThickness="1"/>
                    <Button x:Name="BtnApply" Content="Apply Equal % Composition" Click="BtnApply_Click" Padding="12,4" Margin="4,0" Background="#1E3A8A" Foreground="#FFFFFF" FontWeight="Bold" BorderBrush="#3B82F6" BorderThickness="1"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Category Filters & Quick Presets -->
        <Border x:Name="CategoryRibbonBorder" Grid.Row="1" Background="#2B2D31" BorderBrush="#3F4248" BorderThickness="0,0,0,1" Padding="10,6">
            <StackPanel Background="Transparent">
                <WrapPanel x:Name="PanelCategoryFilters" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,4">
                    <TextBlock Text="Category Filter: " FontWeight="Bold" FontSize="11" Foreground="#CBD5E1" VerticalAlignment="Center" Margin="2,0,6,0"/>
                    <Button Content="All (118)" Tag="all" Click="BtnCategoryFilter_Click" Padding="8,2" Margin="2" FontSize="10.5" FontWeight="Bold" Background="#3F4248" Foreground="#FFFFFF" BorderBrush="#60A5FA" BorderThickness="1.5"/>
                    <Button Content="Transition" Tag="transition" Click="BtnCategoryFilter_Click" Padding="8,2" Margin="2" FontSize="10.5" Background="#2B2D31" Foreground="#F2F3F5" BorderBrush="#4E5058"/>
                    <Button Content="Post-Transition" Tag="post-transition" Click="BtnCategoryFilter_Click" Padding="8,2" Margin="2" FontSize="10.5" Background="#2B2D31" Foreground="#F2F3F5" BorderBrush="#4E5058"/>
                    <Button Content="Metalloids" Tag="metalloid" Click="BtnCategoryFilter_Click" Padding="8,2" Margin="2" FontSize="10.5" Background="#2B2D31" Foreground="#F2F3F5" BorderBrush="#4E5058"/>
                    <Button Content="Nonmetals" Tag="nonmetal" Click="BtnCategoryFilter_Click" Padding="8,2" Margin="2" FontSize="10.5" Background="#2B2D31" Foreground="#F2F3F5" BorderBrush="#4E5058"/>
                    <Button Content="Alkali" Tag="alkali" Click="BtnCategoryFilter_Click" Padding="8,2" Margin="2" FontSize="10.5" Background="#2B2D31" Foreground="#F2F3F5" BorderBrush="#4E5058"/>
                    <Button Content="Alkaline Earth" Tag="alkaline-earth" Click="BtnCategoryFilter_Click" Padding="8,2" Margin="2" FontSize="10.5" Background="#2B2D31" Foreground="#F2F3F5" BorderBrush="#4E5058"/>
                    <Button Content="Halogens" Tag="halogen" Click="BtnCategoryFilter_Click" Padding="8,2" Margin="2" FontSize="10.5" Background="#2B2D31" Foreground="#F2F3F5" BorderBrush="#4E5058"/>
                    <Button Content="Lanthanides" Tag="lanthanide" Click="BtnCategoryFilter_Click" Padding="8,2" Margin="2" FontSize="10.5" Background="#2B2D31" Foreground="#F2F3F5" BorderBrush="#4E5058"/>
                    <Button Content="Actinides" Tag="actinide" Click="BtnCategoryFilter_Click" Padding="8,2" Margin="2" FontSize="10.5" Background="#2B2D31" Foreground="#F2F3F5" BorderBrush="#4E5058"/>
                    <Button Content="Noble Gases" Tag="noble" Click="BtnCategoryFilter_Click" Padding="8,2" Margin="2" FontSize="10.5" Background="#2B2D31" Foreground="#F2F3F5" BorderBrush="#4E5058"/>
                </WrapPanel>
                <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Quick Alloy Presets: " FontWeight="Bold" FontSize="11" Foreground="#CBD5E1" VerticalAlignment="Center" Margin="2,0,8,0"/>
                    <Button Content="Cantor (CoCrFeMnNi)" Click="BtnPreset_Click" Tag="Co,Cr,Fe,Mn,Ni" Padding="8,3" Margin="2" FontSize="11" Background="#2B2D31" Foreground="#F2F3F5" BorderBrush="#4E5058"/>
                    <Button Content="AlCoCrFeNi" Click="BtnPreset_Click" Tag="Al,Co,Cr,Fe,Ni" Padding="8,3" Margin="2" FontSize="11" Background="#2B2D31" Foreground="#F2F3F5" BorderBrush="#4E5058"/>
                    <Button Content="Senkov RHEA (NbMoTaW)" Click="BtnPreset_Click" Tag="Nb,Mo,Ta,W" Padding="8,3" Margin="2" FontSize="11" Background="#2B2D31" Foreground="#F2F3F5" BorderBrush="#4E5058"/>
                    <Button Content="TiZrHfNbTa" Click="BtnPreset_Click" Tag="Ti,Zr,Hf,Nb,Ta" Padding="8,3" Margin="2" FontSize="11" Background="#2B2D31" Foreground="#F2F3F5" BorderBrush="#4E5058"/>
                    <Button Content="Inconel 718" Click="BtnPreset_Click" Tag="Ni,Cr,Fe,Nb,Mo,Ti,Al" Padding="8,3" Margin="2" FontSize="11" Background="#2B2D31" Foreground="#F2F3F5" BorderBrush="#4E5058"/>
                    <Button Content="Stainless 316L" Click="BtnPreset_Click" Tag="Fe,Cr,Ni,Mo,Mn,Si" Padding="8,3" Margin="2" FontSize="11" Background="#2B2D31" Foreground="#F2F3F5" BorderBrush="#4E5058"/>
                    <Button Content="Ti-6Al-4V" Click="BtnPreset_Click" Tag="Ti,Al,V" Padding="8,3" Margin="2" FontSize="11" Background="#2B2D31" Foreground="#F2F3F5" BorderBrush="#4E5058"/>
                    <Button Content="AA 7075" Click="BtnPreset_Click" Tag="Al,Zn,Mg,Cu,Cr" Padding="8,3" Margin="2" FontSize="11" Background="#2B2D31" Foreground="#F2F3F5" BorderBrush="#4E5058"/>
                </WrapPanel>
            </StackPanel>
        </Border>

        <!-- 18x9 Element Grid -->
        <ScrollViewer x:Name="ElementsScrollViewer" Grid.Row="2" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Padding="10" Background="#202225">
            <Grid x:Name="GridElements" HorizontalAlignment="Center" VerticalAlignment="Top"/>
        </ScrollViewer>

        <!-- Bottom Live Selection Inspector -->
        <Border x:Name="BottomInspectorBorder" Grid.Row="3" Background="#2B2D31" BorderBrush="#3F4248" BorderThickness="0,1,0,0" Padding="12,8">
            <DockPanel>
                <TextBlock x:Name="TxtSelectedList" Text="Selected Elements: (click tiles to toggle elements)" FontWeight="Bold" FontSize="12" Foreground="#F2F3F5"/>
                <TextBlock x:Name="TxtHoverInfo" Text="Hover any element tile for physical &amp; crystallographic data" DockPanel.Dock="Right" FontSize="11" Foreground="#949BA4"/>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>

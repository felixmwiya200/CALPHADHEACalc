<Window x:Class="PyCalphadSuite.Desktop.Dialogs.DatabaseSelectorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Select CALPHAD Materials System &amp; Database"
        Width="780" Height="560" WindowStartupLocation="CenterOwner"
        Background="#FFFFFF" Foreground="#000000">
    <Grid Margin="14" Background="#FFFFFF">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="CALPHAD Materials Family &amp; Database Selector" FontWeight="Bold" FontSize="15" Foreground="#000000"/>
                <TextBlock Text="Select any metallurgical system and calibrated alloy preset to mount its physical engine." FontSize="11.5" Foreground="#000000"/>
            </StackPanel>
        </DockPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left: Database List -->
            <GroupBox Grid.Column="0" Header="14 Alloy Databases" FontWeight="SemiBold" Background="#FFFFFF" Foreground="#000000" BorderBrush="#CBD5E1" Padding="6">
                <ListBox x:Name="LstDatabases" SelectionChanged="LstDatabases_SelectionChanged" BorderThickness="0" FontSize="12.5" Background="#FFFFFF" Foreground="#000000"/>
            </GroupBox>

            <!-- Right: Details & Presets -->
            <GroupBox Grid.Column="2" Header="Database Specification &amp; Calibrated Presets" FontWeight="SemiBold" Background="#FFFFFF" Foreground="#000000" BorderBrush="#CBD5E1" Padding="10">
                <Grid Background="#FFFFFF">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,10">
                        <TextBlock x:Name="TxtDbName" Text="High Entropy Alloys" FontWeight="Bold" FontSize="14" Foreground="#000000"/>
                        <TextBlock x:Name="TxtDbTdb" Text="Mounted TDBs: Dynamic SGTE" FontSize="11.5" Foreground="#000000" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,3,0,2"/>
                        <TextBlock x:Name="TxtDbElements" Text="Elements: ..." FontSize="11.5" Foreground="#000000" TextWrapping="Wrap"/>
                    </StackPanel>

                    <DockPanel Grid.Row="1">
                        <TextBlock Text="Select Calibrated Alloy Preset:" DockPanel.Dock="Top" FontWeight="Bold" FontSize="12" Foreground="#000000" Margin="0,0,0,6"/>
                        <ListBox x:Name="LstPresets" MouseDoubleClick="LstPresets_MouseDoubleClick" FontSize="12" Background="#FFFFFF" Foreground="#000000" BorderBrush="#CBD5E1"/>
                    </DockPanel>
                </Grid>
            </GroupBox>
        </Grid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Cancel" IsCancel="True" Width="100" Height="32" Margin="0,0,8,0" Background="#FFFFFF" Foreground="#000000" BorderBrush="#CBD5E1" BorderThickness="1"/>
            <Button Content="Mount Selected System" IsDefault="True" Click="BtnOk_Click" Width="170" Height="32" Background="#FFFFFF" Foreground="#000000" FontWeight="Bold" BorderBrush="#CBD5E1" BorderThickness="1"/>
        </StackPanel>
    </Grid>
</Window>

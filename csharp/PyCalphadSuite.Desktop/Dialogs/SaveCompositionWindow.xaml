<Window x:Class="PyCalphadSuite.Desktop.Dialogs.SaveCompositionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Save / Open Alloy Compositions"
        Width="680" Height="510" WindowStartupLocation="CenterOwner"
        Background="#FFFFFF" Foreground="#000000">
    <Grid Margin="14" Background="#FFFFFF">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="14,10" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="Alloy Composition Library &amp; File Interchange" Foreground="#000000" FontWeight="Bold" FontSize="14.5"/>
                <TextBlock Text="Save chemistries as portable .comp.json / .csv files or in your preset library, and reopen saved files anytime." Foreground="#000000" FontSize="11.5"/>
            </StackPanel>
        </Border>

        <TabControl x:Name="ModeTabs" Grid.Row="1" Background="#FFFFFF" BorderBrush="#CBD5E1" Foreground="#000000">
            <!-- Save Tab -->
            <TabItem Header="Save Current Composition" Foreground="#000000" Background="#FFFFFF">
                <StackPanel Margin="14" Background="#FFFFFF">
                    <TextBlock Text="Composition Name:" FontWeight="Bold" FontSize="12" Foreground="#000000"/>
                    <TextBox x:Name="TxtCompName" Padding="8,5" FontSize="13" Margin="0,4,0,10" Background="#FFFFFF" Foreground="#000000" BorderBrush="#CBD5E1"/>

                    <TextBlock Text="Active Chemistry Summary:" FontWeight="Bold" FontSize="12" Foreground="#000000"/>
                    <Border Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="4" Padding="10,8" Margin="0,4,0,10">
                        <TextBlock x:Name="TxtPreviewSummary" Text="Co 20%, Cr 20%, Fe 20%, Mn 20%, Ni 20%" TextWrapping="Wrap" FontFamily="Consolas" FontSize="11.5" Foreground="#000000"/>
                    </Border>

                    <TextBlock Text="Notes / Heat Treatment / Reference (Optional):" FontWeight="Bold" FontSize="12" Foreground="#000000"/>
                    <TextBox x:Name="TxtNotes" Height="54" AcceptsReturn="True" TextWrapping="Wrap" Padding="6" Margin="0,4,0,12" Background="#FFFFFF" Foreground="#000000" BorderBrush="#CBD5E1"/>

                    <CheckBox x:Name="ChkSaveLibrary" Content="Add to Persistent Preset Library (available in Preset dropdown)" IsChecked="True" FontWeight="SemiBold" Foreground="#000000" Margin="0,2"/>
                    <CheckBox x:Name="ChkExportFile" Content="Save Portable Composition File (.comp.json / .csv)..." IsChecked="True" FontWeight="SemiBold" Foreground="#000000" Margin="0,6,0,0"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                        <Button Content="Save Only to File..." Click="BtnSaveFileOnly_Click" Padding="14,7" Margin="0,0,8,0" Background="#FFFFFF" Foreground="#000000" FontWeight="SemiBold" BorderBrush="#CBD5E1" BorderThickness="1"/>
                        <Button Content="Save Composition" Click="BtnSave_Click" Padding="16,7" Background="#FFFFFF" Foreground="#000000" FontWeight="Bold" BorderBrush="#CBD5E1" BorderThickness="1"/>
                    </StackPanel>
                </StackPanel>
            </TabItem>

            <!-- Manage / Load Tab -->
            <TabItem Header="Saved Compositions Library" Foreground="#000000" Background="#FFFFFF">
                <Grid Margin="10" Background="#FFFFFF">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <DataGrid x:Name="GridSavedComps" Grid.Row="0" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" HeadersVisibility="Column" GridLinesVisibility="Horizontal" Background="#FFFFFF" Foreground="#000000" AlternatingRowBackground="#FFFFFF" RowBackground="#FFFFFF" BorderBrush="#CBD5E1">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Composition Name" Binding="{Binding Name}" Width="180"/>
                            <DataGridTextColumn Header="Database" Binding="{Binding DatabaseName}" Width="150"/>
                            <DataGridTextColumn Header="Basis" Binding="{Binding Basis}" Width="55"/>
                            <DataGridTextColumn Header="Saved (UTC)" Binding="{Binding SavedAtUtc, StringFormat=yyyy-MM-dd HH:mm}" Width="125"/>
                            <DataGridTextColumn Header="Notes" Binding="{Binding Notes}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <DockPanel Grid.Row="1" Margin="0,10,0,0">
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                            <Button Content="Open Composition File (.comp.json / .csv / .dat)..." Click="BtnImportFile_Click" Padding="10,5" Background="#FFFFFF" Foreground="#000000" BorderBrush="#CBD5E1" BorderThickness="1" FontWeight="SemiBold" Margin="0,0,6,0"/>
                            <Button Content="Export Selected..." Click="BtnExportSelected_Click" Padding="10,5" Background="#FFFFFF" Foreground="#000000" BorderBrush="#CBD5E1" BorderThickness="1" Margin="0,0,6,0"/>
                            <Button Content="Delete" Click="BtnDelete_Click" Padding="10,5" Background="#FFFFFF" Foreground="#000000" BorderBrush="#CBD5E1" BorderThickness="1"/>
                        </StackPanel>
                        <Button Content="Load Selected into Solver" Click="BtnLoadSelected_Click" DockPanel.Dock="Right" Padding="14,5" Background="#FFFFFF" Foreground="#000000" BorderBrush="#CBD5E1" BorderThickness="1" FontWeight="Bold"/>
                    </DockPanel>
                </Grid>
            </TabItem>
        </TabControl>

        <Button Grid.Row="2" Content="Close" IsCancel="True" HorizontalAlignment="Right" Width="95" Height="30" Margin="0,10,0,0" Background="#FFFFFF" Foreground="#000000" BorderBrush="#CBD5E1" BorderThickness="1"/>
    </Grid>
</Window>

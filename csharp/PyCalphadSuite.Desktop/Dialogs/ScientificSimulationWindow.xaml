<Window x:Class="PyCalphadSuite.Desktop.Dialogs.ScientificSimulationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctrl="clr-namespace:PyCalphadSuite.Desktop.Controls"
        Title="Physical Metallurgy Simulation &amp; Utility Analyzer"
        Width="880" Height="640" WindowStartupLocation="CenterOwner"
        Background="#FFFFFF" Foreground="#000000">
    <Grid Margin="12" Background="#FFFFFF">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="14,10" Margin="0,0,0,10">
            <DockPanel>
                <StackPanel>
                    <TextBlock x:Name="TxtDialogTitle" Text="Physical Metallurgy Simulation Analyzer" Foreground="#000000" FontWeight="Bold" FontSize="15"/>
                    <TextBlock x:Name="TxtDialogSubtitle" Text="Real-time computation via CALPHAD XOC Core" Foreground="#000000" FontSize="11.5" Margin="0,2,0,0"/>
                </StackPanel>
                <Button x:Name="BtnRunModule" Content="Run / Refresh" DockPanel.Dock="Right" Click="BtnRunModule_Click" Padding="14,6" Background="#FFFFFF" Foreground="#000000" FontWeight="Bold" BorderBrush="#CBD5E1" BorderThickness="1"/>
            </DockPanel>
        </Border>

        <!-- Dynamic Parameter Bar -->
        <Border x:Name="ParamPanelBorder" Grid.Row="1" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="4" Padding="10,8" Margin="0,0,0,8">
            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock x:Name="LblParam1" Text="Parameter 1:" Foreground="#000000" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <TextBox x:Name="TxtParam1" Text="973.15" Width="90" Padding="5,3" Margin="0,0,14,0" Background="#FFFFFF" Foreground="#000000" BorderBrush="#CBD5E1"/>
                <TextBlock x:Name="LblParam2" Text="Parameter 2:" Foreground="#000000" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <TextBox x:Name="TxtParam2" Text="620" Width="90" Padding="5,3" Margin="0,0,14,0" Background="#FFFFFF" Foreground="#000000" BorderBrush="#CBD5E1"/>
                <TextBlock x:Name="TxtSimResultSummary" Text="Calculating..." FontWeight="Bold" Foreground="#000000" VerticalAlignment="Center"/>
            </WrapPanel>
        </Border>

        <!-- Main View Area (Plot OR DataGrid OR Unit Converter) -->
        <Grid Grid.Row="2" Background="#FFFFFF">
            <!-- 1. Scientific Plot Host -->
            <ctrl:PlotCanvasHost x:Name="SimPlotHost" Visibility="Visible"/>

            <!-- 2. Tabular Data Explorer (Oxide DB / Literature HEAs / Batch Screen) -->
            <DataGrid x:Name="SimDataGrid" Visibility="Collapsed" AutoGenerateColumns="True" IsReadOnly="True" Background="#FFFFFF" Foreground="#000000" RowBackground="#FFFFFF" AlternatingRowBackground="#FFFFFF" HeadersVisibility="Column" GridLinesVisibility="All" BorderBrush="#CBD5E1"/>

            <!-- 3. Unit Converter Panel -->
            <Border x:Name="ConverterPanel" Visibility="Collapsed" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="20">
                <StackPanel MaxWidth="520">
                    <TextBlock Text="Materials Engineering Unit &amp; Basis Converter" Foreground="#000000" FontWeight="Bold" FontSize="15" Margin="0,0,0,12"/>
                    <Grid Margin="0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180"/>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Temperature (°C -> K / °F):" Foreground="#000000" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <TextBox x:Name="TxtConvTempC" Text="1000" Grid.Column="1" Padding="6,4" Background="#FFFFFF" Foreground="#000000" BorderBrush="#CBD5E1" TextChanged="TxtConv_TextChanged"/>
                        <TextBlock x:Name="LblConvTempOut" Text="= 1273.15 K  |  1832.0 °F" Grid.Column="2" VerticalAlignment="Center" Margin="12,0,0,0" FontWeight="Bold" Foreground="#000000"/>
                    </Grid>
                    <Grid Margin="0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180"/>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Stress (MPa -> GPa / ksi):" Foreground="#000000" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <TextBox x:Name="TxtConvStress" Text="450" Grid.Column="1" Padding="6,4" Background="#FFFFFF" Foreground="#000000" BorderBrush="#CBD5E1" TextChanged="TxtConv_TextChanged"/>
                        <TextBlock x:Name="LblConvStressOut" Text="= 0.450 GPa  |  65.27 ksi" Grid.Column="2" VerticalAlignment="Center" Margin="12,0,0,0" FontWeight="Bold" Foreground="#000000"/>
                    </Grid>
                    <Grid Margin="0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180"/>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Energy (kJ/mol -> eV/atom):" Foreground="#000000" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <TextBox x:Name="TxtConvEnergy" Text="100" Grid.Column="1" Padding="6,4" Background="#FFFFFF" Foreground="#000000" BorderBrush="#CBD5E1" TextChanged="TxtConv_TextChanged"/>
                        <TextBlock x:Name="LblConvEnergyOut" Text="= 1.0364 eV/atom" Grid.Column="2" VerticalAlignment="Center" Margin="12,0,0,0" FontWeight="Bold" Foreground="#000000"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Footer -->
        <DockPanel Grid.Row="3" Margin="0,10,0,0">
            <Button x:Name="BtnLoadSelectedAlloy" Content="Load Selected Alloy into Solver" Visibility="Collapsed" Click="BtnLoadSelectedAlloy_Click" Padding="14,6" Background="#FFFFFF" Foreground="#000000" FontWeight="Bold" BorderBrush="#CBD5E1" BorderThickness="1"/>
            <Button Content="Close" IsCancel="True" DockPanel.Dock="Right" Width="100" Height="30" HorizontalAlignment="Right" Background="#FFFFFF" Foreground="#000000" BorderBrush="#CBD5E1" BorderThickness="1"/>
        </DockPanel>
    </Grid>
</Window>

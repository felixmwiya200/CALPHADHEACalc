<Window x:Class="PyCalphadSuite.Desktop.Dialogs.ExperimentalOptionsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CALPHAD XOC - Experimental Options"
        Width="780" Height="640" MinWidth="680" MinHeight="500"
        WindowStartupLocation="CenterOwner"
        Background="#F1F5F9" Foreground="#0F172A">
    <Grid Margin="12" Background="#F1F5F9">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Row 0: Simple Preset Selection Bar -->
        <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="4" Padding="12,8" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="280"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Processing Preset:" FontWeight="SemiBold" FontSize="12" Foreground="#0F172A" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <ComboBox x:Name="CmbPreset" Grid.Column="1" SelectionChanged="CmbPreset_SelectionChanged" Height="26" VerticalAlignment="Center" FontSize="11.5">
                    <ComboBoxItem Content="L-PBF / SLM Standard (Fine Cell)"/>
                    <ComboBoxItem Content="L-PBF High Productivity"/>
                    <ComboBoxItem Content="DED / Laser Cladding"/>
                    <ComboBoxItem Content="Cast / Ingot (Coarse Grain)"/>
                    <ComboBoxItem Content="Wrought / Annealed (25 µm)"/>
                    <ComboBoxItem Content="Ultrafine-Grained (UFG 1.5 µm)"/>
                    <ComboBoxItem Content="Custom"/>
                </ComboBox>
                <TextBlock x:Name="LblHpPreview" Grid.Column="2" Text="Hall-Petch Δσ_gb: +90.0 MPa" FontWeight="SemiBold" FontSize="11.5" Foreground="#334155" HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- Row 1: Parameter Fields in Clean Scrollable View -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,6,0">
            <StackPanel>

                <!-- Section 1: Grain Size & Microstructure -->
                <GroupBox Header="Microstructure &amp; Grain Size" FontWeight="SemiBold" Foreground="#334155" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" Padding="10,6" Margin="0,0,0,10">
                    <Grid Margin="0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="80"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Grain Diameter d (µm):" FontWeight="Normal" Foreground="#0F172A" VerticalAlignment="Center"/>
                        <Slider x:Name="SliderGrainSize" Grid.Column="1" Minimum="0.5" Maximum="200" Value="25" SmallChange="0.5" LargeChange="5" ValueChanged="Parameter_Changed" VerticalAlignment="Center" Margin="10,0"/>
                        <TextBox x:Name="TxtGrainSize" Grid.Column="2" Text="25.0" Padding="4,2" Background="#FFFFFF" Foreground="#0F172A" BorderBrush="#CBD5E1" TextAlignment="Right" LostFocus="TextBox_LostFocus"/>
                    </Grid>
                </GroupBox>

                <!-- Section 2: Additive Manufacturing Parameters -->
                <GroupBox x:Name="GroupLaserParams" Header="Additive Manufacturing &amp; Laser Parameters" FontWeight="SemiBold" Foreground="#334155" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" Padding="10,6" Margin="0,0,0,10">
                    <StackPanel>
                        <!-- Hatch Pitch -->
                        <Grid Margin="0,3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="80"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Hatch Pitch / Spacing h (µm):" FontWeight="Normal" Foreground="#0F172A" VerticalAlignment="Center"/>
                            <Slider x:Name="SliderHatchPitch" Grid.Column="1" Minimum="30" Maximum="250" Value="80" SmallChange="1" LargeChange="10" ValueChanged="Parameter_Changed" VerticalAlignment="Center" Margin="10,0"/>
                            <TextBox x:Name="TxtHatchPitch" Grid.Column="2" Text="80.0" Padding="4,2" Background="#FFFFFF" Foreground="#0F172A" BorderBrush="#CBD5E1" TextAlignment="Right" LostFocus="TextBox_LostFocus"/>
                        </Grid>

                        <!-- Laser Power -->
                        <Grid Margin="0,3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="80"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Laser Power P (W):" FontWeight="Normal" Foreground="#0F172A" VerticalAlignment="Center"/>
                            <Slider x:Name="SliderLaserPower" Grid.Column="1" Minimum="50" Maximum="800" Value="275" SmallChange="5" LargeChange="25" ValueChanged="Parameter_Changed" VerticalAlignment="Center" Margin="10,0"/>
                            <TextBox x:Name="TxtLaserPower" Grid.Column="2" Text="275.0" Padding="4,2" Background="#FFFFFF" Foreground="#0F172A" BorderBrush="#CBD5E1" TextAlignment="Right" LostFocus="TextBox_LostFocus"/>
                        </Grid>

                        <!-- Scan Speed -->
                        <Grid Margin="0,3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="80"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Scanning Speed v (mm/s):" FontWeight="Normal" Foreground="#0F172A" VerticalAlignment="Center"/>
                            <Slider x:Name="SliderScanSpeed" Grid.Column="1" Minimum="100" Maximum="2500" Value="800" SmallChange="25" LargeChange="100" ValueChanged="Parameter_Changed" VerticalAlignment="Center" Margin="10,0"/>
                            <TextBox x:Name="TxtScanSpeed" Grid.Column="2" Text="800.0" Padding="4,2" Background="#FFFFFF" Foreground="#0F172A" BorderBrush="#CBD5E1" TextAlignment="Right" LostFocus="TextBox_LostFocus"/>
                        </Grid>

                        <!-- Layer Thickness -->
                        <Grid Margin="0,3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="80"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Layer Thickness t (µm):" FontWeight="Normal" Foreground="#0F172A" VerticalAlignment="Center"/>
                            <Slider x:Name="SliderLayerThickness" Grid.Column="1" Minimum="15" Maximum="100" Value="30" SmallChange="1" LargeChange="5" ValueChanged="Parameter_Changed" VerticalAlignment="Center" Margin="10,0"/>
                            <TextBox x:Name="TxtLayerThickness" Grid.Column="2" Text="30.0" Padding="4,2" Background="#FFFFFF" Foreground="#0F172A" BorderBrush="#CBD5E1" TextAlignment="Right" LostFocus="TextBox_LostFocus"/>
                        </Grid>

                        <!-- Beam Spot Diameter -->
                        <Grid Margin="0,3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="80"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Beam Spot Diameter d_spot (µm):" FontWeight="Normal" Foreground="#0F172A" VerticalAlignment="Center"/>
                            <Slider x:Name="SliderSpotDiameter" Grid.Column="1" Minimum="40" Maximum="150" Value="75" SmallChange="1" LargeChange="5" ValueChanged="Parameter_Changed" VerticalAlignment="Center" Margin="10,0"/>
                            <TextBox x:Name="TxtSpotDiameter" Grid.Column="2" Text="75.0" Padding="4,2" Background="#FFFFFF" Foreground="#0F172A" BorderBrush="#CBD5E1" TextAlignment="Right" LostFocus="TextBox_LostFocus"/>
                        </Grid>
                    </StackPanel>
                </GroupBox>

                <!-- Section 3: Calculated Solidification Indicators -->
                <GroupBox x:Name="GroupLaserIndicators" Header="Calculated Solidification Indicators" FontWeight="SemiBold" Foreground="#334155" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" Padding="10,8" Margin="0,0,0,10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- VED -->
                        <StackPanel Grid.Row="0" Grid.Column="0" Margin="4">
                            <TextBlock Text="Energy Density (VED):" FontSize="11" Foreground="#64748B" FontWeight="Normal"/>
                            <TextBlock x:Name="LblVedMetric" Text="143.2 J/mm³" FontSize="13" FontWeight="Bold" Foreground="#0F172A" Margin="0,2,0,0"/>
                        </StackPanel>

                        <!-- Cooling Rate -->
                        <StackPanel Grid.Row="0" Grid.Column="1" Margin="4">
                            <TextBlock Text="Cooling Rate Ṫ:" FontSize="11" Foreground="#64748B" FontWeight="Normal"/>
                            <TextBlock x:Name="LblCoolingRateMetric" Text="2.5 × 10⁵ K/s" FontSize="13" FontWeight="Bold" Foreground="#0F172A" Margin="0,2,0,0"/>
                        </StackPanel>

                        <!-- Cell Spacing -->
                        <StackPanel Grid.Row="0" Grid.Column="2" Margin="4">
                            <TextBlock Text="Cell Spacing λ_cell:" FontSize="11" Foreground="#64748B" FontWeight="Normal"/>
                            <TextBlock x:Name="LblCellSpacingMetric" Text="0.82 µm" FontSize="13" FontWeight="Bold" Foreground="#0F172A" Margin="0,2,0,0"/>
                        </StackPanel>

                        <!-- Cell Strength -->
                        <StackPanel Grid.Row="0" Grid.Column="3" Margin="4">
                            <TextBlock Text="Cell Strengthening Δσ:" FontSize="11" Foreground="#64748B" FontWeight="Normal"/>
                            <TextBlock x:Name="LblCellStrengthMetric" Text="+204 MPa" FontSize="13" FontWeight="Bold" Foreground="#0F172A" Margin="0,2,0,0"/>
                        </StackPanel>

                        <!-- Porosity Regime (Hidden as requested) -->
                        <Border x:Name="BadgePorosityRegime" Grid.Row="1" Grid.ColumnSpan="4" Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="4" Padding="8,4" Margin="4,8,4,0" Visibility="Collapsed">
                            <TextBlock x:Name="TxtPorosityBadge" Text="Optimal Conduction Window (>99.8% Relative Density)" FontSize="11" FontWeight="SemiBold" Foreground="#0F172A" HorizontalAlignment="Center"/>
                        </Border>
                    </Grid>
                </GroupBox>

                <!-- Section 4: Cold Work & Heat Treatment -->
                <GroupBox Header="Cold Work &amp; Heat Treatment" FontWeight="SemiBold" Foreground="#334155" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" Padding="10,6" Margin="0,0,0,4">
                    <StackPanel>
                        <!-- Cold Work Strain -->
                        <Grid Margin="0,3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="80"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Cold Work Plastic Strain (% CW):" FontWeight="Normal" Foreground="#0F172A" VerticalAlignment="Center"/>
                            <Slider x:Name="SliderColdWork" Grid.Column="1" Minimum="0" Maximum="80" Value="0" SmallChange="1" LargeChange="10" ValueChanged="Parameter_Changed" VerticalAlignment="Center" Margin="10,0"/>
                            <TextBox x:Name="TxtColdWork" Grid.Column="2" Text="0.0" Padding="4,2" Background="#FFFFFF" Foreground="#0F172A" BorderBrush="#CBD5E1" TextAlignment="Right" LostFocus="TextBox_LostFocus"/>
                        </Grid>

                        <!-- Aging Temp -->
                        <Grid Margin="0,3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="80"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Annealing / Aging Temp (K):" FontWeight="Normal" Foreground="#0F172A" VerticalAlignment="Center"/>
                            <Slider x:Name="SliderHeatTreatTemp" Grid.Column="1" Minimum="300" Maximum="1600" Value="973" SmallChange="10" LargeChange="50" ValueChanged="Parameter_Changed" VerticalAlignment="Center" Margin="10,0"/>
                            <TextBox x:Name="TxtHeatTreatTemp" Grid.Column="2" Text="973.15" Padding="4,2" Background="#FFFFFF" Foreground="#0F172A" BorderBrush="#CBD5E1" TextAlignment="Right" LostFocus="TextBox_LostFocus"/>
                        </Grid>

                        <!-- Aging Hours -->
                        <Grid Margin="0,3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="80"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Exposure Duration (hours):" FontWeight="Normal" Foreground="#0F172A" VerticalAlignment="Center"/>
                            <Slider x:Name="SliderHeatTreatHours" Grid.Column="1" Minimum="0.5" Maximum="100" Value="20" SmallChange="0.5" LargeChange="5" ValueChanged="Parameter_Changed" VerticalAlignment="Center" Margin="10,0"/>
                            <TextBox x:Name="TxtHeatTreatHours" Grid.Column="2" Text="20.0" Padding="4,2" Background="#FFFFFF" Foreground="#0F172A" BorderBrush="#CBD5E1" TextAlignment="Right" LostFocus="TextBox_LostFocus"/>
                        </Grid>
                    </StackPanel>
                </GroupBox>
            </StackPanel>
        </ScrollViewer>

        <!-- Row 2: Clean Footer Actions -->
        <Border Grid.Row="2" Background="#E2E8F0" BorderBrush="#CBD5E1" BorderThickness="0,1,0,0" Padding="10,8" Margin="0,10,0,0">
            <DockPanel LastChildFill="False">
                <Button Content="Reset Defaults" Click="BtnReset_Click" DockPanel.Dock="Left" Padding="12,5" Background="#FFFFFF" Foreground="#0F172A" BorderBrush="#CBD5E1" BorderThickness="1"/>

                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                    <Button Content="Cancel" Click="BtnCancel_Click" IsCancel="True" Padding="14,5" Margin="0,0,8,0" Background="#FFFFFF" Foreground="#0F172A" BorderBrush="#CBD5E1" BorderThickness="1"/>
                    <Button Content="Apply" Click="BtnApply_Click" IsDefault="True" Padding="18,5" Background="#2563EB" Foreground="#FFFFFF" FontWeight="Bold" BorderBrush="#1D4ED8" BorderThickness="1"/>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>

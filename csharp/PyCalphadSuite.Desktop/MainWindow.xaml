                                        <Button x:Name="BtnComputeTernary" Content="Calculate Diagram" Click="BtnComputeTernary_Click" FontWeight="Bold" Background="#0284C7" Foreground="White" Padding="12,4" Margin="0,0,14,0" ToolTip="Compute CALPHAD ternary phase equilibrium diagram on Gibbs triangle"/>
                                    </WrapPanel>
                                </Border>

                                <!-- Main Plot & Information Layout -->
                                <Grid Grid.Row="1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="380"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Left: ScottPlot Canvas Host for Gibbs Triangle -->
                                    <ctrl:PlotCanvasHost x:Name="HostTernaryDiagram" Grid.Column="0" HeaderTitle="Ternary Phase Diagram (Gibbs Equilateral Triangle)" ExportBaseName="Ternary_Phase_Diagram" Margin="0,0,6,0"/>

                                    <!-- Right: Invariant Reactions & Equilibrium Details Panel -->
                                    <Border Grid.Column="1" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="4" Padding="8">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="140"/>
                                            </Grid.RowDefinitions>

                                            <TextBlock Grid.Row="0" Text="Assessed Invariant Reactions &amp; Equilibria:" FontWeight="Bold" FontSize="11.5" Foreground="#0F172A" Margin="0,0,0,6"/>


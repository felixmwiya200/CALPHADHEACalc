                                        <ComboBox x:Name="CmbTernarySystem" Width="260" Height="26" VerticalAlignment="Center" Margin="0,0,10,0" DropDownOpened="CmbTernarySystem_DropDownOpened"/>

                                        <TextBlock Text="Diagram Type:" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#0F172A"/>
                                        <ComboBox x:Name="CmbTernaryType" Width="170" Height="26" VerticalAlignment="Center" Margin="0,0,10,0" SelectedIndex="0">
                                            <ComboBoxItem Content="Isothermal Section"/>
                                            <ComboBoxItem Content="Liquidus Projection"/>

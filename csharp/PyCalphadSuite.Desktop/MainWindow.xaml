                                        <!-- Row 2: Numerical Results DataGrid -->
                                        <DataGrid x:Name="GridExtrapolation" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" Background="#FFFFFF" Foreground="#000000" RowBackground="#FFFFFF" AlternatingRowBackground="#FFFFFF" BorderBrush="#CBD5E1" Margin="0,4,0,0">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="x₁" Binding="{Binding X1, StringFormat={}{0:F4}}" Width="80"/>
                                                <DataGridTextColumn Header="x₂" Binding="{Binding X2, StringFormat={}{0:F4}}" Width="80"/>
                                                <DataGridTextColumn Header="x₃ (fixed)" Binding="{Binding X3, StringFormat={}{0:F4}}" Width="90"/>
                                                <DataGridTextColumn Header="G_ex Muggianu (J/mol)" Binding="{Binding GExMuggianu, StringFormat={}{0:F2}}" Width="160"/>
                                                <DataGridTextColumn Header="G_ex Kohler (J/mol)" Binding="{Binding GExKohler, StringFormat={}{0:F2}}" Width="160"/>
                                                <DataGridTextColumn Header="G_ex Toop (J/mol)" Binding="{Binding GExToop, StringFormat={}{0:F2}}" Width="160"/>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </Grid>
                                </TabItem>

                                <!-- Sub-Tab 3: UHTC Reactive Wetting & Brazing (Cacciamani 2016 Section 3.3) -->
                                <TabItem Header="UHTC Reactive Wetting &amp; Brazing (ZrB₂ / Ni-B)">
                                    <Grid Margin="4">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="140"/>
                                        </Grid.RowDefinitions>


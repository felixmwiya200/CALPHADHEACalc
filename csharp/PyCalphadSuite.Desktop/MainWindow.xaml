                                    <Grid Margin="4">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="1.4*"/>
                                            <RowDefinition Height="1*"/>
                                        </Grid.RowDefinitions>

                                        <!-- Row 0: Controls -->
                                        <Border Grid.Row="0" Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,0,0,6">
                                            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="CEF Phase Preset:" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                <ComboBox x:Name="CboCefPreset" Width="200" SelectionChanged="CboCefPreset_SelectionChanged" Margin="0,0,12,0">
                                                    <ComboBoxItem Content="C15 Laves: (Mg,Cu)1(Mg,Cu)2" IsSelected="True"/>

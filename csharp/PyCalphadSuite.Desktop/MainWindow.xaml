                        </TabItem>
                        <!-- Tab 24: Compound Energy Formalism (CEF) & Advanced CALPHAD (Cacciamani 2016) - Running in background only -->
                        <TabItem x:Name="TabCefUhtc" Header="Compound Energy Formalism (CEF) &amp; UHTC Wetting" Visibility="Collapsed">
                            <TabControl Background="#FFFFFF" BorderBrush="#CBD5E1">

                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="T (°C)" Binding="{Binding TemperatureC, StringFormat={}{0:F1}}" Width="80"/>
                                                <DataGridTextColumn Header="T (K)" Binding="{Binding TemperatureK, StringFormat={}{0:F1}}" Width="80"/>
                                                <DataGridTextColumn Header="G_ref (J/mol)" Binding="{Binding GRef, StringFormat={}{0:F2}}" Width="120"/>
                                                <DataGridTextColumn Header="G_id (J/mol)" Binding="{Binding GId, StringFormat={}{0:F2}}" Width="120"/>
                                                <DataGridTextColumn Header="G_ex (J/mol)" Binding="{Binding GEx, StringFormat={}{0:F2}}" Width="120"/>
                                                <DataGridTextColumn Header="G_mag (J/mol)" Binding="{Binding GMag, StringFormat={}{0:F2}}" Width="120"/>
                                                <DataGridTextColumn Header="Total G_m (J/mol)" Binding="{Binding Gm, StringFormat={}{0:F2}}" Width="130"/>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </Grid>
                                </TabItem>

                                <!-- Sub-Tab 2: Geometric Ternary Extrapolations (Muggianu vs. Kohler vs. Toop) -->
                                <TabItem Header="Ternary Extrapolations (Muggianu / Kohler / Toop)">
                                    <Grid Margin="4">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="1.4*"/>
                                            <RowDefinition Height="1*"/>
                                        </Grid.RowDefinitions>

                                        <!-- Row 0: Controls -->
                                        <Border Grid.Row="0" Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,0,0,6">
                                            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="Fixed Component 3 (x₃):" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                <TextBox x:Name="TxtExtrapX3" Text="0.20" Width="55" Margin="0,0,12,0"/>

                                                <TextBlock Text="Temperature (°C):" VerticalAlignment="Center" Margin="0,0,4,0"/>

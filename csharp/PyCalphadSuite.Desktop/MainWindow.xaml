                                                <TextBlock Text="Step:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                <TextBox x:Name="TxtCefTStep" Text="25" Width="40" Margin="0,0,12,0"/>

                                                <Button x:Name="BtnCalculateCef" Content="Calculate CEF Energy" Click="BtnCalculateCef_Click" FontWeight="SemiBold" Background="#0284C7" Foreground="White" Padding="12,4" Margin="0,0,10,0"/>
                                                <TextBlock x:Name="TxtCefStatus" Text="Ready (Gabriele Cacciamani 2016 Formulation)" FontStyle="Italic" Foreground="#64748B" VerticalAlignment="Center"/>
                                            </WrapPanel>
                                        </Border>


                                                <Button x:Name="BtnCalculateExtrapolation" Content="Compare Extrapolation Models" Click="BtnCalculateExtrapolation_Click" FontWeight="SemiBold" Background="#0284C7" Foreground="White" Padding="12,4" Margin="0,0,10,0"/>

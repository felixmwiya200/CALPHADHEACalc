                                                    <DataGridTextColumn Header="Temp" Binding="{Binding TempFormatted}" Width="65"/>
                                                    <DataGridTextColumn Header="Equation" Binding="{Binding Equation}" Width="*"/>
                                                </DataGrid.Columns>
                                            </DataGrid>

                                            <TextBlock Grid.Row="2" Text="Thermodynamic Notes &amp; Solvus Reference:" FontWeight="Bold" FontSize="11.5" Foreground="#0F172A" Margin="0,8,0,4"/>
                                            
                                            <TextBox x:Name="TxtBinaryNotes" Grid.Row="3" FontFamily="Consolas" FontSize="10.5" Background="#F8FAFC" Foreground="#1E293B" BorderBrush="#CBD5E1" IsReadOnly="True" Padding="6" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                                     Text="Assessed CALPHAD benchmark diagram computed via Redlich-Kister excess Gibbs energy models and pure element SGTE unary melting parameters."/>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </Grid>
                        </TabItem>
                        <!-- Tab: Ternary Phase Diagram (Gibbs Equilateral Triangle & Assessed Benchmarks) -->
                        <TabItem Header="Ternary Phase Diagram">
                            <Grid Margin="4">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>

                                        </Border>
                                    </WrapPanel>
                                </Border>

                                <!-- Main Plot & Information Layout -->
                                <Grid Grid.Row="1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="320"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Left: ScottPlot Canvas Host -->
                                    <ctrl:PlotCanvasHost x:Name="HostBinaryDiagram" Grid.Column="0" HeaderTitle="Binary Phase Diagram" ExportBaseName="Binary_Phase_Diagram" Margin="0,0,6,0"/>

                                    <!-- Right: Invariant Reactions & Equilibrium Details Panel -->
                                    <Border Grid.Column="1" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="4" Padding="8">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="120"/>
                                            </Grid.RowDefinitions>

                                            <TextBlock Grid.Row="0" Text="Assessed Invariant Reactions (F = 0):" FontWeight="Bold" FontSize="11.5" Foreground="#0F172A" Margin="0,0,0,6"/>
                                            
                                            <DataGrid x:Name="GridBinaryInvariants" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" Background="#F8FAFC" BorderBrush="#CBD5E1" RowHeight="24" FontSize="10.5">

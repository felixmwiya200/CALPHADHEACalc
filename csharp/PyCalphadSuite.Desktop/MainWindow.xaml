<Window x:Class="PyCalphadSuite.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ctrl="clr-namespace:PyCalphadSuite.Desktop.Controls"
        mc:Ignorable="d"
        Title="CALPHAD XOC"
        Height="920" Width="1440"
        MinHeight="720" MinWidth="1100"
        Background="#FFFFFF" Foreground="#000000"
        FontFamily="Segoe UI" FontSize="12.5"
        KeyDown="Window_KeyDown">

    <Window.InputBindings>
        <KeyBinding Key="H" Modifiers="Control" Command="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=CmdHome}"/>
        <KeyBinding Key="D" Modifiers="Control" Command="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=CmdSelectDatabase}"/>
        <KeyBinding Key="T" Modifiers="Control" Command="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=CmdToggleTheme}"/>
        <KeyBinding Key="R" Modifiers="Control" Command="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=CmdResetLayout}"/>
        <KeyBinding Key="D1" Modifiers="Control" Command="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=CmdToggleLeftDock}"/>
        <KeyBinding Key="D2" Modifiers="Control" Command="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=CmdToggleConsole}"/>
        <KeyBinding Key="S" Modifiers="Control" Command="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=CmdSaveComposition}"/>
        <KeyBinding Key="O" Modifiers="Control" Command="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=CmdOpenCompositionFile}"/>
        <KeyBinding Key="E" Modifiers="Control" Command="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=CmdExportAllData}"/>
        <KeyBinding Key="E" Modifiers="Control+Shift" Command="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=CmdExperimentalOptions}"/>
        <KeyBinding Key="F11" Command="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=CmdMaximizeCanvas}"/>
    </Window.InputBindings>

    <Grid x:Name="RootShellGrid" Background="#F1F5F9">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 1. COMPLETE TOP MENU BAR -->
        <Menu x:Name="TopMenuBar" Grid.Row="0" Background="#E2E8F0" Foreground="#0F172A" BorderBrush="#CBD5E1" BorderThickness="0,0,0,1" Padding="4,2">
            <!-- FILE MENU -->
            <MenuItem Header="_File" Foreground="#000000">
                <MenuItem Header="_Home" InputGestureText="Ctrl+H" Click="MenuHome_Click"/>
                <MenuItem Header="Select _Database..." InputGestureText="Ctrl+D" Click="MenuSelectDatabase_Click"/>
                <Separator/>
                <MenuItem Header="_Save Composition..." InputGestureText="Ctrl+S" Click="MenuSaveComposition_Click"/>
                <MenuItem Header="_Open Composition..." InputGestureText="Ctrl+O" Click="MenuOpenCompositionFile_Click"/>
                <MenuItem Header="Composition _Library..." Click="MenuLoadComposition_Click"/>
                <Separator/>
                <MenuItem Header="Export _All Data..." InputGestureText="Ctrl+E" Click="MenuExportAllData_Click" FontWeight="Bold"/>
                <Separator/>
                <MenuItem Header="Export .dat..." Click="MenuExportDat_Click"/>
                <MenuItem Header="Export .csv..." Click="MenuExportCsv_Click"/>
                <MenuItem Header="Export PNG..." Click="ExportGraphPng_Click"/>
                <MenuItem Header="Export SVG..." Click="ExportGraphSvg_Click"/>
                <Separator/>
                <MenuItem Header="Export DEFORM..." Click="QuickExportDeform_Click"/>
                <MenuItem Header="Export Simufact..." Click="QuickExportSimufact_Click"/>
                <MenuItem Header="Export COMSOL..." Click="MenuOpenPiecewise_Click"/>
                <Separator/>
                <MenuItem Header="E_xit" Click="Exit_Click"/>
            </MenuItem>

            <!-- VIEW MENU -->
            <MenuItem Header="_View">
                <MenuItem Header="_Reset Default Layout (Ctrl+R)" Click="MenuResetLayout_Click"/>
                <MenuItem Header="Toggle _System &amp; Composition Panel (Ctrl+1)" Click="MenuToggleLeftDock_Click"/>
                <MenuItem Header="Toggle _Console &amp; Telemetry (Ctrl+2)" Click="MenuToggleConsole_Click"/>
                <Separator/>
                <MenuItem Header="_Maximize / Restore Viewport (F11)" Click="MenuMaximizeCanvas_Click"/>
            </MenuItem>

            <!-- MATERIAL TYPES MENU -->
            <MenuItem x:Name="MenuMaterialTypes" Header="_Material Types">
                <MenuItem Header="_Home" Click="MenuHome_Click"/>
                <MenuItem Header="_Select Database..." InputGestureText="Ctrl+D" Click="MenuSelectDatabase_Click"/>
                <Separator/>
                <!-- Dynamically populated with 14 Databases + 19 Published Materials Submenu -->
            </MenuItem>

            <!-- OPTIONS MENU -->
            <MenuItem Header="_Options">
                <MenuItem Header="Theme">
                    <MenuItem x:Name="MenuThemeGrey" Header="Grey Theme (Professional Engineering CAE)" IsCheckable="True" IsChecked="True" Click="MenuGreyTheme_Click"/>
                    <MenuItem x:Name="MenuThemeLight" Header="Light Theme (Clean White)" IsCheckable="True" Click="MenuLightTheme_Click"/>
                    <MenuItem x:Name="MenuThemeDark" Header="Dark Theme (Charcoal / Slate)" IsCheckable="True" Click="MenuDarkTheme_Click"/>
                    <Separator/>
                    <MenuItem Header="Cycle Theme (Ctrl+T)" Click="BtnThemeToggle_Click"/>
                </MenuItem>
                <MenuItem Header="Temperature Unit">
                    <MenuItem x:Name="MenuTempK" Header="Kelvin (K)" IsCheckable="True" IsChecked="True" Click="MenuTempK_Click"/>
                    <MenuItem x:Name="MenuTempC" Header="Celsius (°C)" IsCheckable="True" Click="MenuTempC_Click"/>
                </MenuItem>
                <Separator/>
                <MenuItem Header="Experimental Options (Hatch Pitch &amp; Grain Size)..." Click="MenuExperimentalOptions_Click" InputGestureText="Ctrl+Shift+E"/>
                <Separator/>
                <MenuItem x:Name="MenuVerbose" Header="Run in verbose mode" IsCheckable="True" Click="MenuVerbose_Click"/>
                <MenuItem x:Name="MenuRecordSession" Header="Record session" IsCheckable="True" Click="MenuRecordSession_Click"/>
                <Separator/>
                <MenuItem Header="Temperature stepping..." Click="MenuSimDialog_Click" Tag="step_temperature"/>
                <MenuItem Header="Concentration stepping..." Click="MenuSimDialog_Click" Tag="concentration_step"/>
                <MenuItem Header="Single thermod. calculation..." Click="MenuSimDialog_Click" Tag="single_step"/>
                <MenuItem Header="Solidification (Scheil-Gulliver)..." Click="MenuSimDialog_Click" Tag="phases_properties"/>
                <MenuItem Header="Lattice mismatch (Gamma/Gamma')..." Click="MenuSimDialog_Click" Tag="lattice_mismatch"/>
                <MenuItem Header="Creep modeling..." Click="MenuSimDialog_Click" Tag="creep"/>
                <MenuItem Header="Fatigue S-N modeling..." Click="MenuSimDialog_Click" Tag="fatigue"/>
                <MenuItem Header="TTT / CCT diagrams..." Click="MenuSimDialog_Click" Tag="ttt_cct"/>
                <MenuItem Header="Stacking fault energy (SFE)..." Click="MenuSimDialog_Click" Tag="sfe"/>
                <MenuItem Header="Precipitate coarsening (LSW)..." Click="MenuSimDialog_Click" Tag="coarsening"/>
                <MenuItem Header="General Steel Jominy hardenability..." Click="MenuSimDialog_Click" Tag="jominy"/>
                <Separator/>
                <MenuItem Header="Forming Export">
                    <MenuItem Header="Export to ABAQUS (*MATERIAL)..." Click="QuickExportCard_Click" Tag="abaqus"/>
                    <MenuItem Header="Export to ANSYS (MPDATA)..." Click="QuickExportCard_Click" Tag="ansys"/>
                    <MenuItem Header="Export to COMSOL Multiphysics..." Click="QuickExportCard_Click" Tag="comsol"/>
                    <MenuItem Header="Export to LS-DYNA (*MAT)..." Click="QuickExportCard_Click" Tag="lsdyna"/>
                    <MenuItem Header="Export to Sysweld..." Click="QuickExportCard_Click" Tag="sysweld"/>
                    <MenuItem Header="Export to DEFORM-HT..." Click="QuickExportCard_Click" Tag="deform"/>
                    <MenuItem Header="Export to Simufact..." Click="QuickExportCard_Click" Tag="simufact"/>
                </MenuItem>
            </MenuItem>

            <!-- UTILITIES MENU -->
            <MenuItem Header="_Utilities">
                <MenuItem Header="Austenite grain size estimation..." Click="MenuSimDialog_Click" Tag="austenite_grain"/>
                <MenuItem Header="Periodic Table..." Click="MenuPeriodicTable_Click"/>
                <MenuItem Header="3D Crystal Structures &amp; Atomic Lattices..." Click="MenuCrystalStructures_Click"/>
                <Separator/>
                <MenuItem Header="Engineering Conversions (°C/K, MPa/ksi, Energy)..." Click="MenuSimDialog_Click" Tag="conversions"/>
                <MenuItem Header="Martensite transition (Ms / Mf / HV)..." Click="MenuSimDialog_Click" Tag="martensite"/>
                <Separator/>
                <MenuItem Header="Ellingham Oxide Thermochemistry Database..." Click="MenuSimDialog_Click" Tag="oxide_db"/>
                <MenuItem Header="Laves Phases &amp; Intermetallic Compounds (IMCs)..." Click="MenuSimDialog_Click" Tag="imc_laves_db"/>
                <MenuItem Header="Curated Literature HEA Repository..." Click="MenuSimDialog_Click" Tag="literature_heas"/>
            </MenuItem>

            <!-- HELP MENU -->
            <MenuItem Header="_Help">
                <MenuItem Header="_About CALPHAD XOC..." Click="About_Click"/>
                <MenuItem Header="_Quick Start Guide..." Click="QuickStart_Click"/>
                <MenuItem Header="Academic Authorship &amp; Credits..." Click="Authorship_Click"/>
                <MenuItem Header="Literature References &amp; DOIs..." Click="References_Click"/>
            </MenuItem>

            <!-- UNIFIED ARCHITECTURE & ENGINES MENU -->
            <MenuItem Header="_Architecture" Visibility="Collapsed">
                <MenuItem Header="Unified Front End: C# + C++ + C Polyglot Architecture" IsChecked="True" IsCheckable="True" StaysOpenOnClick="True"/>
                <Separator/>
                <MenuItem Header="C# .NET 8 (WPF Presentation, Controls &amp; ScottPlot 5 Graphs)" IsChecked="True" IsCheckable="True" StaysOpenOnClick="True"/>
                <MenuItem Header="C++20 Native Engine (Embedded DirectX 11 3D Viewport)" IsChecked="True" IsCheckable="True" StaysOpenOnClick="True"/>
                <MenuItem Header="C11 Metallurgy Physics Core (High-Performance Numerical SIMD)" IsChecked="True" IsCheckable="True" StaysOpenOnClick="True"/>
                <MenuItem Header="Python 3.12 (Headless CALPHAD Thermodynamic Engine Daemon)" IsChecked="True" IsCheckable="True" StaysOpenOnClick="True"/>
                <Separator/>
                <MenuItem Header="Polyglot Architecture Diagnostics..." Click="MenuPolyglotDiagnostics_Click"/>
            </MenuItem>
        </Menu>

        <!-- 2. QUICK PARAMETER TOOLBAR -->
        <Border x:Name="QuickToolbarBorder" Grid.Row="1" Background="#E2E8F0" BorderBrush="#CBD5E1" BorderThickness="0,0,0,1" Padding="8,5">
            <DockPanel LastChildFill="True">
                <WrapPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                    <Button x:Name="BtnBasisToggle" Content="wt%" Click="BtnBasisToggle_Click" ToolTip="Toggle Chemistry Basis between wt%, at%, and mol" Width="48" Padding="6,4" Margin="2,0" FontWeight="Bold" Background="#FFFFFF" Foreground="#000000" BorderBrush="#CBD5E1" BorderThickness="1" Visibility="Collapsed"/>
                    <Button x:Name="BtnTempUnitToggle" Content="Temp: K" Click="BtnTempUnitToggle_Click" ToolTip="Toggle Temperature Unit between K and °C" Width="72" Padding="6,4" Margin="2,0" FontWeight="Bold" Background="#FFFFFF" Foreground="#000000" BorderBrush="#CBD5E1" BorderThickness="1" Visibility="Collapsed"/>
                    <Separator Width="1" Background="#CBD5E1" Margin="6,2" Visibility="Collapsed"/>
                    <Button Content="Material Types..." Click="MenuSelectDatabase_Click" Padding="10,4" Margin="2,0" FontWeight="Bold" Background="#FFFFFF" Foreground="#000000" BorderBrush="#CBD5E1" BorderThickness="1" Visibility="Collapsed"/>
                    <Button Content="Home" Click="MenuHome_Click" Padding="10,4" Margin="2,0" FontWeight="Bold" Background="#FFFFFF" Foreground="#000000" BorderBrush="#CBD5E1" BorderThickness="1"/>
                    <Button Content="Periodic Table" Click="MenuPeriodicTable_Click" Padding="10,4" Margin="2,0" FontWeight="Bold" Background="#FFFFFF" Foreground="#000000" BorderBrush="#CBD5E1" BorderThickness="1"/>
                    <Button Content="Save Comp..." Click="MenuSaveComposition_Click" ToolTip="Save Composition to File or Library (Ctrl+S)" Padding="10,4" Margin="4,0,2,0" FontWeight="Bold" Background="#FFFFFF" Foreground="#000000" BorderBrush="#CBD5E1" BorderThickness="1" Visibility="Collapsed"/>
                    <Button Content="Open File..." Click="MenuOpenCompositionFile_Click" ToolTip="Open Saved Composition File (.comp.json / .csv / .dat) (Ctrl+O)" Padding="10,4" Margin="2,0" FontWeight="Bold" Background="#FFFFFF" Foreground="#000000" BorderBrush="#CBD5E1" BorderThickness="1" Visibility="Collapsed"/>
                    <Button Content="Export All Data..." Click="MenuExportAllData_Click" ToolTip="Export ALL plots, curves CSVs, validation tables, .dat &amp; FEA decks (Ctrl+E)" Padding="10,4" Margin="2,0" FontWeight="Bold" Background="#FFFFFF" Foreground="#000000" BorderBrush="#CBD5E1" BorderThickness="1" Visibility="Collapsed"/>
                    <Button x:Name="BtnThemeToggle" Content="Theme: Light" Click="BtnThemeToggle_Click" ToolTip="Toggle Theme between Grey, Light, and Dark (Ctrl+T)" Padding="10,4" Margin="4,0" FontWeight="Bold" Background="#FFFFFF" Foreground="#000000" BorderBrush="#CBD5E1" BorderThickness="1"/>
                    <Separator Width="1" Background="#CBD5E1" Margin="6,2" Visibility="Collapsed"/>
                    <TextBlock Text="Active System: " Foreground="#000000" VerticalAlignment="Center" Margin="4,0,2,0" FontSize="11.5" Visibility="Collapsed"/>
                    <TextBlock x:Name="TxtToolbarSystem" Text="High Entropy Alloys" Foreground="#000000" FontWeight="Bold" VerticalAlignment="Center" FontSize="12" Visibility="Collapsed"/>
                </WrapPanel>
            </DockPanel>
        </Border>

        <!-- 3. CENTRAL WORKSPACE (Left Parameter Dock + Stacked Center [Welcome / Tabs] + Bottom Console) -->
        <Grid Grid.Row="2" Margin="6" Background="#F1F5F9">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition x:Name="RowConsoleSplitter" Height="4"/>
                <RowDefinition x:Name="RowConsole" Height="190" MinHeight="0" MaxHeight="380"/>
            </Grid.RowDefinitions>

            <!-- Top Row: Left Dock + Central Workspace Stack -->
            <Grid Grid.Row="0" Background="#FFFFFF">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="ColLeftDock" Width="355" MinWidth="0" MaxWidth="460"/>
                    <ColumnDefinition x:Name="ColLeftSplitter" Width="4"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Left Resizable System & Chemistry Dock -->
                <ScrollViewer x:Name="LeftDockPanel" Grid.Column="0" VerticalScrollBarVisibility="Auto" Padding="0,0,4,0" Background="#FFFFFF">
                    <StackPanel Background="#FFFFFF">
                        <GroupBox Header="Materials System &amp; Chemistry" FontWeight="SemiBold" Margin="0,0,0,8" Background="#FFFFFF" Foreground="#000000" BorderBrush="#CBD5E1" Padding="8">
                            <StackPanel>
                                <DockPanel Margin="0,2,0,2">
                                    <TextBlock Text="Alloy Family:" FontSize="11" FontWeight="Bold" Foreground="#000000" VerticalAlignment="Center"/>
                                    <Button Content="All Types..." DockPanel.Dock="Right" Click="MenuSelectDatabase_Click" Padding="6,2" FontSize="10.5" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" Foreground="#000000"/>
                                </DockPanel>
                                <ComboBox x:Name="CmbDatabase" SelectionChanged="CmbDatabase_SelectionChanged" Height="28" Margin="0,2,0,0" Background="#FFFFFF" Foreground="#000000"/>

                                <TextBlock Text="Preset Grade Archetype:" FontSize="11" FontWeight="Bold" Foreground="#000000" Margin="0,8,0,2"/>
                                <ComboBox x:Name="CmbPresets" SelectionChanged="CmbPresets_SelectionChanged" Height="28" Background="#FFFFFF" Foreground="#000000"/>

                                <TextBlock Text="Composition Basis:" FontSize="11" FontWeight="Bold" Foreground="#000000" Margin="0,8,0,4"/>
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton x:Name="RbWt" Content="wt%" Foreground="#000000" IsChecked="True" Margin="0,0,16,0" Checked="RbBasis_Checked"/>
                                    <RadioButton x:Name="RbAt" Content="at%" Foreground="#000000" Margin="0,0,16,0" Checked="RbBasis_Checked"/>
                                    <RadioButton x:Name="RbMol" Content="mol" Foreground="#000000" Checked="RbBasis_Checked"/>
                                </StackPanel>

                                <TextBlock Text="Chemical Composition:" FontSize="11" FontWeight="Bold" Foreground="#000000" Margin="0,10,0,4"/>
                                <DataGrid x:Name="GridComposition" AutoGenerateColumns="False" CanUserAddRows="True" CanUserDeleteRows="True" Height="140"
                                          SelectionMode="Extended" SelectionUnit="FullRow" PreviewKeyDown="GridComposition_PreviewKeyDown"
                                          HeadersVisibility="Column" Background="#FFFFFF" Foreground="#000000" RowBackground="#FFFFFF" AlternatingRowBackground="#FFFFFF" BorderBrush="#CBD5E1" RowHeaderWidth="0">
                                    <DataGrid.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="Remove Selected Element(s)" Click="BtnRemoveElement_Click"/>
                                            <MenuItem Header="Normalize to 100% / 1.0" Click="BtnNormalize_Click"/>
                                        </ContextMenu>
                                    </DataGrid.ContextMenu>
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Element" Binding="{Binding Element}" Width="*"/>
                                        <DataGridTextColumn Header="Fraction" Binding="{Binding Fraction}" Width="*"/>
                                    </DataGrid.Columns>
                                </DataGrid>

                                <UniformGrid Columns="4" Margin="0,6,0,0">
                                    <Button Content="+ Add" Click="BtnAddElement_Click" Height="26" Background="#FFFFFF" Foreground="#000000" BorderBrush="#CBD5E1" BorderThickness="1" Margin="0,0,2,0" FontSize="11" ToolTip="Add a new element row"/>
                                    <Button x:Name="BtnRemoveElement" Content="- Remove" Click="BtnRemoveElement_Click" Height="26" Background="#FFFFFF" Foreground="#B91C1C" BorderBrush="#CBD5E1" BorderThickness="1" Margin="2,0,2,0" FontSize="11" FontWeight="SemiBold" ToolTip="Remove selected element row(s) from the composition (Del)"/>
                                    <Button Content="Periodic..." Click="MenuPeriodicTable_Click" Height="26" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" Foreground="#000000" Margin="2,0,2,0" FontSize="11" FontWeight="SemiBold"/>
                                    <Button x:Name="BtnNormalize" Content="Norm 100%" Click="BtnNormalize_Click" Height="26" Background="#FFFFFF" Foreground="#000000" BorderBrush="#CBD5E1" BorderThickness="1" Margin="2,0,0,0" FontSize="11"/>
                                </UniformGrid>
                                <UniformGrid Columns="3" Margin="0,4,0,0">
                                    <Button Content="Save Comp..." Click="MenuSaveComposition_Click" Height="26" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" Foreground="#000000" Margin="0,0,2,0" FontSize="11" FontWeight="SemiBold"/>
                                    <Button Content="Open File..." Click="MenuOpenCompositionFile_Click" Height="26" Background="#FFFFFF" Foreground="#000000" BorderBrush="#CBD5E1" BorderThickness="1" Margin="2,0,2,0" FontSize="11" FontWeight="SemiBold"/>
                                    <Button Content="Export All" Click="MenuExportAllData_Click" Height="26" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" Foreground="#000000" Margin="2,0,0,0" FontSize="11" FontWeight="Bold"/>
                                </UniformGrid>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="Thermodynamic Solver Parameters" FontWeight="SemiBold" Margin="0,0,0,8" Background="#FFFFFF" Foreground="#000000" BorderBrush="#CBD5E1" Padding="8">
                            <StackPanel>
                                <StackPanel Visibility="Collapsed">
                                    <TextBlock Text="Calculation Mode:" FontSize="11" FontWeight="Bold" Foreground="#000000" Margin="0,2,0,2"/>
                                    <ComboBox x:Name="CmbCalcMode" Height="26" Background="#FFFFFF" Foreground="#000000">
                                        <ComboBoxItem Content="Thorough" IsSelected="True"/>
                                        <ComboBoxItem Content="Deep"/>
                                        <ComboBoxItem Content="Fast"/>
                                    </ComboBox>
                                </StackPanel>

                                <TextBlock Text="Manufacturing Route:" FontSize="11" FontWeight="Bold" Foreground="#000000" Margin="0,6,0,2"/>
                                <ComboBox x:Name="CmbProcess" Height="26" Background="#FFFFFF" Foreground="#000000" SelectionChanged="CmbProcess_SelectionChanged">
                                    <ComboBoxItem Content="HVOF Thermal Spray" IsSelected="True"/>
                                    <ComboBoxItem Content="Laser Powder Bed Fusion (LPBF / SLM)"/>
                                    <ComboBoxItem Content="Vacuum Arc Remelting (VAR)"/>
                                    <ComboBoxItem Content="Investment Casting"/>
                                </ComboBox>

                                <DockPanel Margin="0,6,0,2">
                                    <TextBlock Text="Hall-Petch Grain Size:" FontSize="11" FontWeight="Bold" Foreground="#000000"/>
                                    <TextBlock x:Name="LblGrainSize" Text="25 μm" DockPanel.Dock="Right" FontWeight="SemiBold" Foreground="#000000"/>
                                </DockPanel>
                                <Slider x:Name="SliderGrain" Minimum="1" Maximum="200" Value="25" ValueChanged="SliderGrain_ValueChanged" Height="24" Margin="0,2,0,10"/>

                                <Button x:Name="BtnExperimentalOptions" Content="⚙  Experimental Options (Hatch &amp; Grain)..." Click="MenuExperimentalOptions_Click"
                                        Margin="0,0,0,12" Padding="10,6" Background="#FFFFFF" Foreground="#0F172A" FontWeight="SemiBold" FontSize="11.5" BorderBrush="#CBD5E1" BorderThickness="1"
                                        ToolTip="Configure Hatch Pitch, Grain Size, Laser AM parameters, and thermomechanical history for all alloy calculations (Ctrl+Shift+E)"/>

                                <TextBlock Text="Temperature Unit:" FontSize="11" FontWeight="Bold" Foreground="#000000" Margin="0,6,0,2"/>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <RadioButton x:Name="RbTempK" Content="Kelvin (K)" Foreground="#000000" IsChecked="True" Margin="0,0,14,0" Checked="RbTempUnit_Checked"/>
                                    <RadioButton x:Name="RbTempC" Content="Celsius (°C)" Foreground="#000000" Checked="RbTempUnit_Checked"/>
                                </StackPanel>

                                <Grid Margin="0,4,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,3,0">
                                        <TextBlock x:Name="LblTStart" Text="T Start (K):" FontSize="10" Foreground="#000000"/>
                                        <TextBox x:Name="TxtTStart" Text="300" Padding="4,2" Background="#FFFFFF" Foreground="#000000" BorderBrush="#CBD5E1"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="2,0,2,0">
                                        <TextBlock x:Name="LblTStop" Text="T Stop (K):" FontSize="10" Foreground="#000000"/>
                                        <TextBox x:Name="TxtTStop" Text="1800" Padding="4,2" Background="#FFFFFF" Foreground="#000000" BorderBrush="#CBD5E1"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Margin="3,0,0,0">
                                        <TextBlock x:Name="LblTStep" Text="Step (K):" FontSize="10" Foreground="#000000"/>
                                        <TextBox x:Name="TxtTStep" Text="25" Padding="4,2" Background="#FFFFFF" Foreground="#000000" BorderBrush="#CBD5E1"/>
                                    </StackPanel>
                                </Grid>

                                <Button x:Name="BtnCalculate" Content="Calculate Properties" Click="BtnCalculate_Click" Height="36" Background="#FFFFFF" Foreground="#000000" FontWeight="Bold" FontSize="13" BorderBrush="#CBD5E1" BorderThickness="1"/>

                                <UniformGrid Columns="3" Margin="0,6,0,0">
                                    <Button x:Name="BtnStep" Content="Step (ΔT)" Click="BtnStep_Click" Height="28" Margin="0,0,3,0" Background="#FFFFFF" Foreground="#000000" FontWeight="SemiBold" BorderBrush="#CBD5E1" BorderThickness="1" FontSize="11"/>
                                    <Button x:Name="BtnHalt" Content="Stop" Click="BtnHalt_Click" Height="28" Margin="2,0,2,0" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" Foreground="#000000" FontWeight="SemiBold" FontSize="11" ToolTip="Stop active calculation gracefully (Shortcut: S)"/>
                                    <Button x:Name="BtnReset" Content="Reset" Click="BtnReset_Click" Height="28" Margin="3,0,0,0" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" Foreground="#000000" FontWeight="SemiBold" FontSize="11"/>
                                </UniformGrid>
                            </StackPanel>
                        </GroupBox>

                        <!-- Live Summary Box -->
                        <GroupBox x:Name="GrpSummary" Header="Summary" FontWeight="SemiBold" Background="#FFFFFF" Foreground="#000000" BorderBrush="#CBD5E1" Padding="8">
                            <StackPanel>
                                <TextBlock x:Name="LblQuickSolidus" Text="Solidus / Liquidus: -- K" FontSize="11" FontWeight="SemiBold" Foreground="#000000"/>
                                <TextBlock x:Name="LblQuickPhase" Text="Phase: --" FontSize="11" Foreground="#000000" Margin="0,2,0,0"/>
                                <TextBlock x:Name="LblQuickStrength" Text="Yield: -- MPa | Hardness: -- HV / --" FontSize="11" Foreground="#000000" FontWeight="SemiBold" Margin="0,2,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>

                <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch" Background="#CBD5E1"/>

                <!-- Central Stacked Area: Welcome Screen OR 20-Tab Workspace -->
                <Grid Grid.Column="2">
                    <!-- Welcome Startup Screen -->
                    <ctrl:WelcomeSplashControl x:Name="WelcomeScreenView" Visibility="Collapsed"/>

                    <!-- 20-Tab Workspace Viewport -->
                    <TabControl x:Name="MainTabs" Background="#FFFFFF" Foreground="#000000" BorderBrush="#CBD5E1" Visibility="Visible" SelectionChanged="MainTabs_SelectionChanged">
                        <TabControl.Resources>
                            <Style TargetType="TabItem">
                                <Setter Property="Background" Value="#FFFFFF"/>
                                <Setter Property="Foreground" Value="#000000"/>
                            </Style>
                        </TabControl.Resources>

                        <!-- Category 1: Phase Equilibria & Solidification -->
                        <TabItem Header="Phase Equilibria &amp; Solidification">
                        <TabControl x:Name="SubTabsEquilibria" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="0,1,0,0">
                            <TabControl.Resources>
                                <Style TargetType="TabItem">
                                    <Setter Property="FontSize" Value="11"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="Padding" Value="9,4"/>
                                    <Setter Property="Margin" Value="0,0,2,0"/>
                                    <Setter Property="Background" Value="#F8FAFC"/>

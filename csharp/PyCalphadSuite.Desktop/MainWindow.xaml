                                                </DataGrid.Columns>
                                            </DataGrid>

                                            <TextBlock Grid.Row="2" Text="Thermodynamic Assessment &amp; Citations:" FontWeight="Bold" FontSize="11.5" Foreground="#0F172A" Margin="0,8,0,4"/>

                                            <TextBox x:Name="TxtTernaryNotes" Grid.Row="3" FontFamily="Consolas" FontSize="10.5" Background="#F8FAFC" Foreground="#1E293B" BorderBrush="#CBD5E1" IsReadOnly="True" Padding="6" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                                     Text="Assessed CALPHAD ternary phase diagram computed via Redlich-Kister-Muggianu excess Gibbs energy model on an equilateral Gibbs triangle."/>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </Grid>
                        </TabItem>
                        <!-- Tab 12: Ellingham Diagram -->

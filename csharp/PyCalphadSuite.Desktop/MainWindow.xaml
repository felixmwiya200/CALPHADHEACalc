                                                    <ComboBoxItem Content="TiB2 (Group 4)"/>
                                                </ComboBox>

                                                <TextBlock Text="Liquid Sessile Drop:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                <ComboBox x:Name="CboUhtcDrop" Width="140" Margin="0,0,12,0">
                                                    <ComboBoxItem Content="Ni-17at% B (Eutectic)" IsSelected="True"/>
                                                    <ComboBoxItem Content="Co-18.5at% B"/>
                                                    <ComboBoxItem Content="Fe-17at% B"/>
                                                </ComboBox>

                                                <TextBlock Text="Isothermal Temp (°C):" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                <TextBox x:Name="TxtUhtcTemp" Text="1130" Width="55" Margin="0,0,12,0"/>

                                                <Button x:Name="BtnCalculateUhtc" Content="Simulate Wetting &amp; Solidification" Click="BtnCalculateUhtc_Click" FontWeight="SemiBold" Background="#0284C7" Foreground="White" Padding="12,4" Margin="0,0,10,0"/>
                                                <TextBlock x:Name="TxtUhtcStatus" Text="Cacciamani Sessile Drop Reaction &amp; Transient Tau Boride Model" FontStyle="Italic" Foreground="#64748B" VerticalAlignment="Center"/>
                                            </WrapPanel>
                                        </Border>

                                        <!-- Row 1: Dual Plots (Left: Isothermal Reaction, Right: Cooling Solidification) -->
                                        <Grid Grid.Row="1">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="1*"/>
                                                <ColumnDefinition Width="1*"/>
                                            </Grid.ColumnDefinitions>
                                            <ctrl:PlotCanvasHost x:Name="HostUhtcIsothermal" Grid.Column="0" HeaderTitle="Isothermal Dissolution &amp; Transient Tau-Phase (Zr₃Ni₂₀B₆) Precipitation" ExportBaseName="UHTC_Isothermal_Reaction" Margin="0,0,4,0"/>
                                            <ctrl:PlotCanvasHost x:Name="HostUhtcCooling" Grid.Column="1" HeaderTitle="Subsequent Solidification Path: Primary ZrB₂ + Secondary Tau + Eutectic" ExportBaseName="UHTC_Solidification" Margin="4,0,0,0"/>
                                        </Grid>

                                        <!-- Row 2: Theoretical Explanation & Kinetic Insights -->
                                        <Border Grid.Row="2" Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,6,0,0">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="*"/>
                                                </Grid.RowDefinitions>
                                                <TextBlock Grid.Row="0" Text="CALPHAD Reactive Wetting Kinetics (Gabriele Cacciamani 2016, Fig. 5):" FontWeight="SemiBold" FontSize="11.5" Foreground="#334155" Margin="0,0,0,4"/>
                                                <TextBox x:Name="TxtUhtcExplanation" Grid.Row="1" FontFamily="Consolas" FontSize="11.5" Background="White" Foreground="#1E293B" BorderBrush="#CBD5E1" IsReadOnly="True" Padding="6" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                                         Text="During the isothermal reaction at 1130°C, the Ni-17at%B liquid droplet dissolves Zr and B from the ceramic substrate. As the liquid composition trajectory traverses the two-phase field (Liquid + Zr₃Ni₂₀B₆), transient precipitation and growth of the cubic tau-phase boride (cF116) occurs. Continued mass transport toward saturation with ZrB₂ causes subsequent re-dissolution of the tau-phase. Upon cooling, primary ZrB₂ precipitates, followed by secondary tau-phase and final ternary eutectic solidification (Ni_ss + Ni₃B + Zr₃Ni₂₀B₆ + ZrB₂)."/>
                                            </Grid>

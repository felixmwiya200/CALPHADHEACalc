                                        <DataGridTextColumn Header="Solution Type" Binding="{Binding SolutionType}" Width="140"/>
                                        <DataGridTextColumn Header="Study Type" Binding="{Binding StudyType}" Width="100"/>
                                        <DataGridTextColumn Header="Match %" Binding="{Binding MatchPercent, StringFormat={}{0:F1}%}" Width="75"/>
                                        <DataGridTextColumn Header="Experimental Synthesis Details" Binding="{Binding SynthesisDetails}" Width="280"/>
                                        <DataGridTemplateColumn Header="DOI / Reference" Width="*">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Margin="4,2" VerticalAlignment="Center">
                                                        <TextBlock.ContextMenu>
                                                            <ContextMenu>
                                                                <MenuItem Header="Open in Browser" Click="OnDoiContextOpenClick"/>
                                                                <MenuItem Header="Copy DOI" Click="OnDoiContextCopyClick"/>
                                                                <MenuItem Header="Copy DOI URL" Click="OnDoiContextCopyUrlClick"/>
                                                            </ContextMenu>
                                                        </TextBlock.ContextMenu>
                                                        <Hyperlink Click="OnDoiHyperlinkClick" Tag="{Binding Doi}" Foreground="#1D4ED8" Cursor="Hand" TextDecorations="Underline"
                                                                   ToolTip="{Binding Doi, StringFormat='Click to open https://doi.org/{0} in web browser'}">
                                                            <Run Text="{Binding Doi, Mode=OneWay}"/>
                                                        </Hyperlink>
                                                    </TextBlock>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>

                                <!-- Row 3: Detail Pane with Full Synthesis & Literature Citation -->
                                <Border Grid.Row="3" Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,6,0,0">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Text="Peer-Reviewed Experimental Synthesis Route &amp; Processing Parameters:" FontWeight="SemiBold" FontSize="11.5" Foreground="#475569" Margin="0,0,0,4"/>
                                        <TextBox x:Name="TxtHeaDetailPane" Grid.Row="1" Text="Select an alloy above to inspect its complete melting, heat treatment, cold rolling, and experimental validation procedure." FontFamily="Consolas" FontSize="12" Background="White" Foreground="#1E293B" BorderBrush="#CBD5E1" IsReadOnly="True" Padding="6" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
                                    </Grid>
                                </Border>
                            </Grid>
                        </TabItem>
                        <!-- Tab 19: Interactive Periodic Table -->
                        <TabItem Header="Periodic Table">
                            <ctrl:PeriodicTableControl x:Name="PeriodicTableView"/>
                        </TabItem>
                        <!-- Tab 20: Thermodynamic & Aqueous Database Inspector -->
                        <TabItem Header="Thermodynamic &amp; Aqueous Database Inspector">
                            <TabControl x:Name="TabControlTdatInspector" BorderThickness="0" Background="Transparent" Margin="2">
                                <!-- Sub-Tab 1: GWB / EQ3/6 .tdat Aqueous & Geochemical Database Explorer -->
                                <TabItem Header="Authoritative .tdat Database Explorer (8 Databases)">
                                    <Grid Margin="4">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <!-- Row 0: Database Selection & Search Toolbar -->
                                        <Border Grid.Row="0" Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,0,0,6">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="280"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="220"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Grid.Column="0" Text="Database:" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="12" Margin="0,0,8,0"/>
                                                <ComboBox x:Name="CmbTdatDatabase" Grid.Column="1" VerticalAlignment="Center" Padding="4,3" SelectionChanged="CmbTdatDatabase_SelectionChanged" Margin="0,0,16,0">
                                                    <ComboBoxItem Content="thermo.com.V8.R6+.tdat (LLNL Master)" IsSelected="True"/>
                                                    <ComboBoxItem Content="thermo.tdat (GWB Core)"/>
                                                    <ComboBoxItem Content="thermo_minteq.tdat (EPA MINTEQA2)"/>
                                                    <ComboBoxItem Content="thermo_nea.tdat (OECD Nuclear Energy Agency)"/>
                                                    <ComboBoxItem Content="thermo_sit.tdat (Specific Ion Interaction SIT)"/>
                                                    <ComboBoxItem Content="thermo_phreeqc.R3.8.9.tdat (USGS PHREEQC)"/>
                                                    <ComboBoxItem Content="thermo_wateq4f.tdat (USGS WATEQ4F)"/>
                                                    <ComboBoxItem Content="thermo_hmw.tdat (Harvie-Møller-Weare Brines)"/>
                                                </ComboBox>

                                                <TextBlock Grid.Column="2" Text="Search Species:" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="12" Margin="0,0,8,0"/>
                                                <TextBox x:Name="TxtTdatSearch" Grid.Column="3" Text="" VerticalAlignment="Center" Padding="4,3" KeyDown="TxtTdatSearch_KeyDown" Margin="0,0,10,0"/>

                                                <Button x:Name="BtnSearchTdat" Grid.Column="4" Content="🔍 Search" Background="#0284C7" Foreground="White" FontWeight="SemiBold" Padding="12,4" Click="BtnSearchTdat_Click" Cursor="Hand"/>
                                            </Grid>
                                        </Border>

                                        <!-- Row 1: Database Metadata Header -->
                                        <Border Grid.Row="1" Background="#EEF2F6" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="3" Padding="8,5" Margin="0,0,0,6">
                                            <TextBlock x:Name="TxtTdatDatabaseSummary" Text="LLNL EQ3/6 V8.R6+ Master Thermodynamic Database: 81 Elements, 1,122 Minerals, 1,503 Aqueous Species (0 to 300 °C steam saturation)" FontSize="11.5" Foreground="#334155" FontWeight="Medium"/>
                                        </Border>

                                        <!-- Row 2: DataGrid for Minerals, Aqueous Complexes & Redox Couples -->
                                        <DataGrid x:Name="GridTdatSpecies" Grid.Row="2" AutoGenerateColumns="False" CanUserAddRows="False"
                                                  IsReadOnly="True" GridLinesVisibility="All" HeadersVisibility="Column"
                                                  AlternatingRowBackground="#F8FAFC" RowHeight="26" SelectionMode="Single"
                                                  SelectionChanged="GridTdatSpecies_SelectionChanged"
                                                  BorderBrush="#CBD5E1" BorderThickness="1" Background="White">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Species / Mineral" Binding="{Binding Name}" Width="160" FontWeight="SemiBold"/>
                                                <DataGridTextColumn Header="Phase Type" Binding="{Binding PhaseType}" Width="120"/>
                                                <DataGridTextColumn Header="Formula" Binding="{Binding Formula}" Width="110"/>
                                                <DataGridTextColumn Header="Subtype / Charge" Binding="{Binding Subtype}" Width="110"/>
                                                <DataGridTextColumn Header="Mole Wt (g/mol)" Binding="{Binding MoleWt, StringFormat={}{0:F2}}" Width="110"/>
                                                <DataGridTextColumn Header="Vol (cc)" Binding="{Binding MoleVolCc, StringFormat={}{0:F2}}" Width="75"/>
                                                <DataGridTextColumn Header="Log K (25°C)" Binding="{Binding LogK25C, StringFormat={}{0:F3}}" Width="95"/>
                                                <DataGridTextColumn Header="Log K (100°C)" Binding="{Binding LogK100C, StringFormat={}{0:F3}}" Width="100"/>
                                                <DataGridTextColumn Header="Balanced Chemical Reaction Equation" Binding="{Binding Reaction}" Width="*"/>
                                            </DataGrid.Columns>
                                        </DataGrid>

                                        <!-- Row 3: Reaction Detail Pane -->
                                        <Border Grid.Row="3" Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,6,0,0">
                                            <StackPanel>
                                                <TextBlock Text="Thermodynamic Reaction &amp; Standard State Dissolution:" FontWeight="SemiBold" FontSize="11.5" Foreground="#475569" Margin="0,0,0,3"/>
                                                <TextBox x:Name="TxtTdatReactionDetail" Text="Select a mineral or aqueous species to inspect its stoichiometry and temperature polynomial." FontFamily="Consolas" FontSize="12" Background="White" Foreground="#1E293B" BorderBrush="#CBD5E1" IsReadOnly="True" Padding="6" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </TabItem>

                                <!-- Sub-Tab 2: Surface Complexation & Sorption Datasets (.sdat) -->
                                <TabItem Header="Surface Complexation &amp; Sorption (.sdat, 17 Databases)">
                                    <Grid Margin="4">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="130"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>

                                        <!-- Row 0: Database Selection Toolbar -->
                                        <Border Grid.Row="0" Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,0,0,6">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="280"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="200"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Grid.Column="0" Text="Surface Dataset:" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="12" Margin="0,0,8,0"/>
                                                <ComboBox x:Name="CmbSdatDatabase" Grid.Column="1" VerticalAlignment="Center" Padding="4,3" SelectionChanged="CmbSdatDatabase_SelectionChanged" Margin="0,0,16,0"/>

                                                <TextBlock Grid.Column="2" Text="Search Species:" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="12" Margin="0,0,8,0"/>
                                                <TextBox x:Name="TxtSdatSearch" Grid.Column="3" Text="" VerticalAlignment="Center" Padding="4,3" KeyDown="TxtSdatSearch_KeyDown" Margin="0,0,10,0"/>

                                                <Button x:Name="BtnSearchSdat" Grid.Column="4" Content="🔍 Filter" Background="#0284C7" Foreground="White" FontWeight="SemiBold" Padding="12,4" Click="BtnSearchSdat_Click" Cursor="Hand" Margin="0,0,8,0"/>
                                            </Grid>
                                        </Border>

                                        <!-- Row 1: Dataset Summary Banner -->
                                        <Border Grid.Row="1" Background="#EEF2F6" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="3" Padding="8,5" Margin="0,0,0,6">
                                            <TextBlock x:Name="TxtSdatDatabaseSummary" Text="Surface Complexation Model for Passive Oxide Films: Site Densities &amp; Binding Constants" FontSize="11.5" Foreground="#334155" FontWeight="Medium"/>
                                        </Border>

                                        <!-- Row 2: Sorbing Minerals Substrate Properties -->
                                        <Border Grid.Row="2" Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="4" Padding="6" Margin="0,0,0,6">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="*"/>
                                                </Grid.RowDefinitions>
                                                <TextBlock Grid.Row="0" Text="Substrate Minerals &amp; Passive Oxide Film Surface Sites:" FontWeight="SemiBold" FontSize="11.5" Foreground="#334155" Margin="0,0,0,3"/>
                                                <DataGrid x:Name="GridSdatMinerals" Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False"
                                                          IsReadOnly="True" GridLinesVisibility="All" HeadersVisibility="Column"
                                                          AlternatingRowBackground="#F8FAFC" RowHeight="24" SelectionMode="Single"
                                                          BorderBrush="#E2E8F0" BorderThickness="1" Background="White">
                                                    <DataGrid.Columns>
                                                        <DataGridTextColumn Header="Mineral / Oxide Film" Binding="{Binding Mineral}" Width="180" FontWeight="SemiBold"/>
                                                        <DataGridTextColumn Header="Specific Surface Area (m²/g)" Binding="{Binding SurfaceAreaM2G, StringFormat={}{0:F1}}" Width="180"/>
                                                        <DataGridTextColumn Header="Complexation Sites" Binding="{Binding Sites.Count}" Width="140"/>
                                                    </DataGrid.Columns>
                                                </DataGrid>
                                            </Grid>
                                        </Border>

                                        <!-- Row 3: Surface Complexation Species & Reactions -->
                                        <DataGrid x:Name="GridSdatSpecies" Grid.Row="3" AutoGenerateColumns="False" CanUserAddRows="False"
                                                  IsReadOnly="True" GridLinesVisibility="All" HeadersVisibility="Column"
                                                  AlternatingRowBackground="#F8FAFC" RowHeight="26" SelectionMode="Single"
                                                  BorderBrush="#CBD5E1" BorderThickness="1" Background="White">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Surface Species" Binding="{Binding Name}" Width="160" FontWeight="SemiBold"/>
                                                <DataGridTextColumn Header="Charge" Binding="{Binding Charge}" Width="80"/>
                                                <DataGridTextColumn Header="Mole Wt (g/mol)" Binding="{Binding MoleWt, StringFormat={}{0:F2}}" Width="110"/>
                                                <DataGridTextColumn Header="Log K (a)" Binding="{Binding LogKA, StringFormat={}{0:F3}}" Width="90"/>
                                                <DataGridTextColumn Header="Log K (b)" Binding="{Binding LogKB, StringFormat={}{0:F3}}" Width="90"/>
                                                <DataGridTextColumn Header="Balanced Surface Complexation Reaction Equation" Binding="{Binding BalancedEquation}" Width="*"/>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </Grid>
                                </TabItem>

                                <!-- Sub-Tab 3: Industrial Electrolyte & OLI Studio Streams (.oad & USGS) -->
                                <TabItem Header="Industrial Electrolyte &amp; OLI Streams (.oad &amp; USGS)">
                                    <Grid Margin="4">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>

                                        <!-- Row 0: Stream Selector Toolbar -->
                                        <Border Grid.Row="0" Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,0,0,6">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="380"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Grid.Column="0" Text="Industrial Electrolyte Stream:" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="12" Margin="0,0,8,0"/>
                                                <ComboBox x:Name="CmbOadStream" Grid.Column="1" VerticalAlignment="Center" Padding="4,3" SelectionChanged="CmbOadStream_SelectionChanged" Margin="0,0,16,0"/>

                                                <Button x:Name="BtnApplyStreamToCorrosion" Grid.Column="2" Content="⚡ Apply Stream to Pourbaix Solver" Background="#1D4ED8" Foreground="White" FontWeight="SemiBold" Padding="12,4" Click="BtnApplyStreamToCorrosion_Click" Cursor="Hand"/>
                                            </Grid>
                                        </Border>

                                        <!-- Row 1: Stream Geochemical Summary & USGS Conductivity Card -->
                                        <Border Grid.Row="1" Background="#EEF2F6" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,0,6">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock x:Name="TxtOadStreamTitle" Text="Industrial Electrolyte Stream Profile" FontWeight="Bold" FontSize="12.5" Foreground="#0F172A"/>
                                                    <TextBlock x:Name="TxtOadStreamDesc" Text="Description of operating geochemical environment" FontSize="11.5" Foreground="#475569" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                                </StackPanel>
                                                <Border Grid.Column="1" Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="4" Padding="8,4" VerticalAlignment="Center">
                                                    <TextBlock x:Name="TxtOadConductivityCard" Text="USGS Conductivity: 50.3 mS/cm | pH: 2.85 | Eh: +550 mV" FontWeight="SemiBold" FontSize="12" Foreground="#0369A1"/>
                                                </Border>
                                            </Grid>
                                        </Border>

                                        <!-- Row 2: Inflow Chemistry DataGrid -->
                                        <DataGrid x:Name="GridOadInflows" Grid.Row="2" AutoGenerateColumns="False" CanUserAddRows="False"
                                                  IsReadOnly="True" GridLinesVisibility="All" HeadersVisibility="Column"
                                                  AlternatingRowBackground="#F8FAFC" RowHeight="26" SelectionMode="Single"
                                                  BorderBrush="#CBD5E1" BorderThickness="1" Background="White">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Inflow Species" Binding="{Binding Species}" Width="150" FontWeight="SemiBold"/>
                                                <DataGridTextColumn Header="Chemical Formula" Binding="{Binding Formula}" Width="140"/>
                                                <DataGridTextColumn Header="Concentration (ppm / mg·L⁻¹)" Binding="{Binding ConcPpm, StringFormat={}{0:N1}}" Width="180"/>
                                                <DataGridTextColumn Header="Geochemical / Environmental Role" Binding="{Binding Role}" Width="*"/>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </Grid>
                                </TabItem>

                                <!-- Sub-Tab 4: Raw Simulation JSON / Text Properties Inspector -->
                                <TabItem Header="Simulation Raw Output &amp; Properties Inspector">
                                    <TextBox x:Name="TxtPropertiesInspector" FontFamily="Consolas" FontSize="12.5" Padding="14"
                                             Background="#FFFFFF" Foreground="#000000" BorderBrush="#CBD5E1" IsReadOnly="True" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap"/>
                                </TabItem>
                            </TabControl>
                        </TabItem>
                        </TabControl>
                        </TabItem>
</TabControl>
                </Grid>
            </Grid>

            <!-- Splitter -->
            <GridSplitter Grid.Row="1" Height="4" HorizontalAlignment="Stretch" Background="#CBD5E1"/>

            <!-- Bottom Resizable Calculation Log Dock -->
            <GroupBox x:Name="BottomConsoleDock" Grid.Row="2" Header="Calculation Log" FontWeight="SemiBold" Foreground="#000000" Background="#FFFFFF" BorderBrush="#CBD5E1" Padding="4">
                <Grid Background="#FFFFFF">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1,1,1,0" Padding="8,4">
                        <DockPanel>
                            <TextBlock x:Name="TxtCalcLogBanner" Text="Solver Idle &gt;&gt; Ready to calculate equilibrium properties" FontFamily="Consolas" FontSize="11.5" FontWeight="SemiBold" Foreground="#000000" VerticalAlignment="Center"/>
                            <Button Content="Clear Log" Click="BtnClearLog_Click" DockPanel.Dock="Right" Padding="8,2" FontSize="10.5" Background="#FFFFFF" Foreground="#000000" BorderBrush="#CBD5E1" BorderThickness="1"/>
                        </DockPanel>
                    </Border>
                    <TextBox x:Name="TxtConsoleLog" Grid.Row="1" FontFamily="Consolas" FontSize="11.5" Background="#FFFFFF" Foreground="#000000" BorderBrush="#CBD5E1" BorderThickness="1"
                             IsReadOnly="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" TextWrapping="NoWrap" Padding="8"/>
                </Grid>
            </GroupBox>
        </Grid>

        <!-- 4. STATUS BAR -->
        <StatusBar x:Name="MainStatusBar" Grid.Row="3" Background="#E2E8F0" Foreground="#334155" BorderBrush="#CBD5E1" BorderThickness="0,1,0,0" Padding="6,2">
            <StatusBarItem>
                <TextBlock x:Name="StatusLabel" Text="Initializing Materials CAE Workbench..." FontWeight="SemiBold" Foreground="#000000"/>
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <StackPanel Orientation="Horizontal">
                    <ProgressBar x:Name="SolverProgress" Width="150" Height="12" Margin="0,0,10,0" IsIndeterminate="False" Value="0" Visibility="Collapsed"/>
                    <TextBlock x:Name="TxtElapsedBadge" Text="Solver Idle" Foreground="#000000" FontWeight="SemiBold" FontSize="11"/>
                </StackPanel>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>

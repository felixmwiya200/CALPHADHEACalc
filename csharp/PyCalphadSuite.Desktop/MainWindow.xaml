                                        <Button x:Name="BtnComputeBinary" Content="Calculate Diagram" Click="BtnComputeBinary_Click" FontWeight="Bold" Background="#0284C7" Foreground="White" Padding="10,4" Margin="0,0,14,0" ToolTip="Compute CALPHAD binary phase equilibrium diagram"/>

                                        <TextBlock Text="Lever Rule at x_B:" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,4,0" Foreground="#0F172A"/>

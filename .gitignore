*.slxc
*.mat.bak
*.mex*
*.tmp
crash_dump*
*.dmr
mccExcludedFiles.log
readme.txt

# Python Caches & Virtual Environments
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
ENV/
build/
dist/
*.spec.bak


# Temporary Scratch & Diagnostic Files
scratch/
temp_*
*.log
*.bak

# Windows OS System Files
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# macOS System Files
.DS_Store
.AppleDouble
.LSOverride

# Editor & IDE Directories
.vscode/
.idea/
*.sublime-project
*.sublime-workspace


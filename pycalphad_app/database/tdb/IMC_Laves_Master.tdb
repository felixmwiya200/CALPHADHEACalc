PARAMETER G(FCC_A1,NI;0) 298.15 +GHSERNI#; 3000.0 N !

PHASE BCC_A2 % 1 1.0 !
CONSTITUENT BCC_A2 :AL,CO,CR,FE,MO,NB,NI,TI,W,ZR: !
PARAMETER G(BCC_A2,AL;0) 298.15 +10083-4.813*T+GHSERAL#; 2900.0 N !
PARAMETER G(BCC_A2,CO;0) 298.15 +2938-0.7138*T+GHSERCO#; 6000.0 N !

PARAMETER G(BCC_A2,TI;0) 298.15 +6667.385-1.45*T+GHSERTI#; 4000.0 N !
PARAMETER G(BCC_A2,W;0) 298.15 +GHSERWW#; 6000.0 N !
PARAMETER G(BCC_A2,ZR;0) 298.15 +4194.2-4.05*T+GHSERZR#; 6000.0 N !

$ 1. LAVES_C14 (MgZn2-type Hexagonal P6_3/mmc, hP12)
PHASE LAVES_C14 % 2 2.0 1.0 !
CONSTITUENT LAVES_C14 :FE,CR,CO,NI,ZN:NB,TI,ZR,MG,MO: !
PARAMETER G(LAVES_C14,FE:NB;0) 298.15 +2*GHSERFE#+GHSERNB#-65400+10.5*T; 6000.0 N !
PARAMETER G(LAVES_C14,CR:NB;0) 298.15 +2*GHSERCR#+GHSERNB#-25800+1.8*T; 6000.0 N !
PARAMETER G(LAVES_C14,CO:NB;0) 298.15 +2*GHSERCO#+GHSERNB#-58200+9.2*T; 6000.0 N !
PARAMETER G(LAVES_C14,FE:TI;0) 298.15 +2*GHSERFE#+GHSERTI#-76500+12.0*T; 6000.0 N !
PARAMETER G(LAVES_C14,CR:TI;0) 298.15 +2*GHSERCR#+GHSERTI#-18500+1.2*T; 6000.0 N !
PARAMETER G(LAVES_C14,FE:MO;0) 298.15 +2*GHSERFE#+GHSERMO#-14200+2.1*T; 6000.0 N !
PARAMETER G(LAVES_C14,ZN:MG;0) 298.15 +GHSERMG#+2*GHSERZN#-39703+58.1*T-6.742*T*LN(T); 3000.0 N !
PARAMETER G(LAVES_C14,FE,CR:NB;0) 298.15 -18000; 6000.0 N !
PARAMETER G(LAVES_C14,CO,CR:NB;0) 298.15 -14000; 6000.0 N !
PARAMETER G(LAVES_C14,NI:NB;0) 298.15 +2*GHSERNI#+GHSERNB#-42000+8.5*T; 6000.0 N !

$ 2. LAVES_C15 (MgCu2-type Cubic Fd-3m, cF24)
PHASE LAVES_C15 % 2 2.0 1.0 !
CONSTITUENT LAVES_C15 :CR,FE,CO,NI,CU:NB,ZR,TI,MG: !
PARAMETER G(LAVES_C15,CR:NB;0) 298.15 +2*GHSERCR#+GHSERNB#-28500+3.2*T; 6000.0 N !

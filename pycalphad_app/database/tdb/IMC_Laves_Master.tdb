PARAMETER G(LIQUID,W;0) 298.15 +52160.584-14.10999*T+GHSERWW#; 6000.0 N !
PARAMETER G(LIQUID,ZN;0) 298.15 +7157.213-10.29299*T+GHSERZN#; 1700.0 N !
PARAMETER G(LIQUID,ZR;0) 298.15 +18147.69-9.080812*T+GHSERZR#; 6000.0 N !

PHASE FCC_A1 % 1 1.0 !
CONSTITUENT FCC_A1 :AL,CO,CR,CU,FE,NI: !
PARAMETER G(FCC_A1,AL;0) 298.15 +GHSERAL#; 2900.0 N !
PARAMETER G(FCC_A1,CO;0) 298.15 +427.59-0.615248*T+GHSERCO#; 6000.0 N !
PARAMETER G(FCC_A1,CR;0) 298.15 +7284+0.163*T+GHSERCR#; 6000.0 N !

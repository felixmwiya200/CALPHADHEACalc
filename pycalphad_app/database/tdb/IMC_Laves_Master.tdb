$ 4. SIGMA (D8_b P4_2/mnm, tP30)
PHASE SIGMA % 3 10.0 4.0 16.0 !
CONSTITUENT SIGMA :FE,NI,CO:CR,MO:FE,NI,CO,CR,MO: !
PARAMETER G(SIGMA,FE:CR:CR;0) 298.15 +10*GHSERFE#+20*GHSERCR#-95000+18.0*T; 6000.0 N !
PARAMETER G(SIGMA,FE:CR:FE;0) 298.15 +26*GHSERFE#+4*GHSERCR#-62000+12.0*T; 6000.0 N !
PARAMETER G(SIGMA,CO:CR:CR;0) 298.15 +10*GHSERCO#+20*GHSERCR#-110000+22.0*T; 6000.0 N !
PARAMETER G(SIGMA,NI:CR:CR;0) 298.15 +10*GHSERNI#+20*GHSERCR#-48000+10.0*T; 6000.0 N !
PARAMETER G(SIGMA,FE:MO:FE;0) 298.15 +26*GHSERFE#+4*GHSERMO#-78000+14.0*T; 6000.0 N !
PARAMETER G(SIGMA,NI:MO:CR;0) 298.15 +10*GHSERNI#+4*GHSERMO#+16*GHSERCR#-82000+15.0*T; 6000.0 N !

$ 5. MU_PHASE (Fe7W6-type R-3m, hR13)
PHASE MU_PHASE % 3 7.0 2.0 4.0 !
CONSTITUENT MU_PHASE :FE,CO,NI:MO,W,NB:FE,CO,CR,MO,W: !
PARAMETER G(MU_PHASE,FE:MO:FE;0) 298.15 +11*GHSERFE#+2*GHSERMO#-54000+7.5*T; 6000.0 N !
PARAMETER G(MU_PHASE,FE:W:FE;0) 298.15 +11*GHSERFE#+2*GHSERWW#-48000+6.0*T; 6000.0 N !
PARAMETER G(MU_PHASE,CO:MO:CO;0) 298.15 +11*GHSERCO#+2*GHSERMO#-62000+8.5*T; 6000.0 N !
PARAMETER G(MU_PHASE,CO:W:W;0) 298.15 +7*GHSERCO#+6*GHSERWW#-78000+10.0*T; 6000.0 N !
PARAMETER G(MU_PHASE,NI:NB:CR;0) 298.15 +7*GHSERNI#+2*GHSERNB#+4*GHSERCR#-125000+18.0*T; 6000.0 N !

$ 6. CHI_A12 (alpha-Mn Cubic I-43m, cI58)
PHASE CHI_A12 % 3 24.0 10.0 24.0 !
CONSTITUENT CHI_A12 :FE,NI,CO:CR,MO:CR,FE,MO: !
PARAMETER G(CHI_A12,FE:MO:CR;0) 298.15 +24*GHSERFE#+10*GHSERMO#+24*GHSERCR#-295000+45.0*T; 6000.0 N !
PARAMETER G(CHI_A12,FE:CR:CR;0) 298.15 +24*GHSERFE#+34*GHSERCR#-180000+32.0*T; 6000.0 N !

$ 7. Ordered B2 & L12
PHASE BCC_B2 % 2 0.5 0.5 !
CONSTITUENT BCC_B2 :AL,TI,FE,CO,NI:AL,FE,CO,NI: !
PARAMETER G(BCC_B2,NI:AL;0) 298.15 +0.5*GHSERNI#+0.5*GHSERAL#-68500+11.2*T; 6000.0 N !
PARAMETER G(BCC_B2,FE:AL;0) 298.15 +0.5*GHSERFE#+0.5*GHSERAL#-31500+6.8*T; 6000.0 N !
PARAMETER G(BCC_B2,CO:AL;0) 298.15 +0.5*GHSERCO#+0.5*GHSERAL#-59800+10.1*T; 6000.0 N !

PHASE FCC_L12 % 2 0.75 0.25 !
CONSTITUENT FCC_L12 :NI,CO,FE:AL,TI,NB: !
PARAMETER G(FCC_L12,NI:AL;0) 298.15 +0.75*GHSERNI#+0.25*GHSERAL#-42200+7.6*T; 6000.0 N !
PARAMETER G(FCC_L12,NI:TI;0) 298.15 +0.75*GHSERNI#+0.25*GHSERTI#-39500+7.2*T; 6000.0 N !
PARAMETER G(FCC_L12,NI:NB;0) 298.15 +0.75*GHSERNI#+0.25*GHSERNB#-32400+6.5*T; 6000.0 N !

$ 8. Solder, Light Alloy & Hardmetal Stoichiometric IMCs
PHASE CU6SN5 % 2 6.0 5.0 !
CONSTITUENT CU6SN5 :CU:SN: !
PARAMETER G(CU6SN5,CU:SN;0) 298.15 +6*GHSERCU#+5*GHSERSN#-75000+16.5*T; 3000.0 N !

PHASE CU3SN % 2 3.0 1.0 !
CONSTITUENT CU3SN :CU:SN: !
PARAMETER G(CU3SN,CU:SN;0) 298.15 +3*GHSERCU#+GHSERSN#-32800+6.8*T; 3000.0 N !

PHASE AG3SN % 2 3.0 1.0 !
CONSTITUENT AG3SN :AG:SN: !
PARAMETER G(AG3SN,AG:SN;0) 298.15 +3*GHSERAG#+GHSERSN#-38500+8.4*T; 3000.0 N !

PHASE AL2CU % 2 2.0 1.0 !
CONSTITUENT AL2CU :AL:CU: !
PARAMETER G(AL2CU,AL:CU;0) 298.15 +2*GHSERAL#+GHSERCU#-47400+6.5*T; 3000.0 N !

PHASE CR7C3 % 2 7.0 3.0 !
CONSTITUENT CR7C3 :CR,FE,CO:C: !
PARAMETER G(CR7C3,CR:C;0) 298.15 +7*GHSERCR#+3*GHSERCC#-186000-14.2*T; 6000.0 N !
PARAMETER G(CR7C3,FE:C;0) 298.15 +7*GHSERFE#+3*GHSERCC#-12000-10.0*T; 6000.0 N !

PHASE WC % 2 1.0 1.0 !
CONSTITUENT WC :W:C: !
PARAMETER G(WC,W:C;0) 298.15 +GHSERWW#+GHSERCC#-40500+4.2*T; 6000.0 N !

PHASE M12C % 3 6.0 6.0 1.0 !
CONSTITUENT M12C :CO,FE:W,MO:C: !
PARAMETER G(M12C,CO:W:C;0) 298.15 +6*GHSERCO#+6*GHSERWW#+GHSERCC#-128000+15.0*T; 6000.0 N !

FUNCTION GHSERTI 298.15 -8059.921+133.615208*T-23.9933*T*LN(T)-0.004777975*T**2; 1941.0 Y -78118.115+429.846*T-47.2*T*LN(T); 4000.0 N !
FUNCTION GHSERWW 298.15 -7646.311+130.4*T-24.1*T*LN(T)-0.001936*T**2; 3695.0 Y -41650.0+320.0*T-44.0*T*LN(T); 6000.0 N !
FUNCTION GHSERZN 298.15 -7285.787+118.470069*T-23.701314*T*LN(T)-0.001712034*T**2; 692.68 Y -11070.559+172.34566*T-31.38*T*LN(T); 1700.0 N !
FUNCTION GHSERZR 298.15 -7827.595+125.64905*T-24.1618*T*LN(T)-0.00437791*T**2; 2128.0 Y -26085.921+262.724183*T-42.144*T*LN(T); 6000.0 N !

TYPE_DEFINITION % SEQ * !
DEFINE_SYSTEM_DEFAULT ELEMENT 2 !

PHASE LIQUID % 1 1.0 !
CONSTITUENT LIQUID :AG,AL,C,CO,CR,CU,FE,MG,MO,NB,NI,SN,TI,W,ZN,ZR: !
PARAMETER G(LIQUID,AG;0) 298.15 +11300-9.6*T+GHSERAG#; 3000.0 N !
PARAMETER G(LIQUID,AL;0) 298.15 +11005.029-11.841867*T+GHSERAL#; 2900.0 N !

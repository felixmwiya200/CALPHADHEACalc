$ Lead-Free Solder CALPHAD Database (Sn-Ag-Cu SAC305)
ELEMENT /- ELECTRON_GAS 0.0000E+00 0.0000E+00 0.0000E+00 !
ELEMENT VA VACUUM 0.0000E+00 0.0000E+00 0.0000E+00 !
ELEMENT SN BCT_A5 1.1871E+02 6.0790E+03 5.1180E+01 !
ELEMENT AG FCC_A1 1.0787E+02 5.7450E+03 4.2550E+01 !
ELEMENT CU FCC_A1 6.3546E+01 5.0041E+03 3.3150E+01 !

FUNCTION GHSERSN 298.15 -5855.1+65.4*T-15.9*T*LN(T); 505.08 Y
 -11200+185.0*T-33.0*T*LN(T); 3000.0 N !

FUNCTION GHSERAG 298.15 -7209.5+118.2*T-23.8*T*LN(T); 1234.93 Y
 -15000+210.0*T-35.0*T*LN(T); 3000.0 N !

FUNCTION GHSERCU 298.15 -7770.4+130.4*T-24.1*T*LN(T); 1357.77 Y
 -13542.0+183.8*T-31.4*T*LN(T); 3000.0 N !

TYPE_DEFINITION % SEQ * !

PHASE LIQUID % 1 1.0 !
CONSTITUENT LIQUID :SN,AG,CU: !
PARAMETER G(LIQUID,SN;0) 298.15 +7070-14.0*T+GHSERSN#; 3000 N !
PARAMETER G(LIQUID,AG;0) 298.15 +11300-9.6*T+GHSERAG#; 3000 N !
PARAMETER G(LIQUID,CU;0) 298.15 +12964.9-9.51*T+GHSERCU#; 3000 N !
PARAMETER G(LIQUID,SN,AG;0) 298.15 -14800+4.5*T; 3000 N !
PARAMETER G(LIQUID,SN,CU;0) 298.15 -25000+6.2*T; 3000 N !

PHASE BCT_A5 % 1 1.0 !
CONSTITUENT BCT_A5 :SN,AG,CU: !
PARAMETER G(BCT_A5,SN;0) 298.15 +GHSERSN#; 3000 N !
PARAMETER G(BCT_A5,AG;0) 298.15 +3500-1.2*T+GHSERAG#; 3000 N !
PARAMETER G(BCT_A5,CU;0) 298.15 +5200-2.0*T+GHSERCU#; 3000 N !

PHASE AG3SN % 2 3.0 1.0 !
CONSTITUENT AG3SN :AG:SN: !
PARAMETER G(AG3SN,AG:SN;0) 298.15 3.0*GHSERAG#+GHSERSN#-38500+8.4*T; 3000 N !

PHASE CU6SN5 % 2 6.0 5.0 !
CONSTITUENT CU6SN5 :CU:SN: !
PARAMETER G(CU6SN5,CU:SN;0) 298.15 6.0*GHSERCU#+5.0*GHSERSN#-75000+16.5*T; 3000 N !

PHASE CU3SN % 2 3.0 1.0 !
CONSTITUENT CU3SN :CU:SN: !
PARAMETER G(CU3SN,CU:SN;0) 298.15 3.0*GHSERCU#+GHSERSN#-32800+6.8*T; 3000 N !

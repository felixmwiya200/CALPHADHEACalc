$ COST 507 Light Metal Alloys Database Subset (Al, Mg, Ti, Si, Fe, Ni)
$ Source: European Concerted Action COST 507 / OpenCALPHAD
$ Reference: Ansara, Dinsdale, Rand (1998)

ELEMENT AL   FCC_A1                    2.6982E+01  4.5773E+03  2.8322E+01 !
ELEMENT MG   HCP_A3                    2.4305E+01  4.9980E+03  3.2670E+01 !
ELEMENT TI   HCP_A3                    4.7867E+01  4.8100E+03  3.0760E+01 !
ELEMENT SI   DIAMOND_A4                2.8085E+01  3.2170E+03  1.8820E+01 !
ELEMENT FE   BCC_A2                    5.5847E+01  4.4890E+03  2.7280E+01 !
ELEMENT NI   FCC_A1                    5.8690E+01  4.7870E+03  2.9796E+01 !

PHASE LIQUID:L %  1  1.0  !
CONSTITUENT LIQUID:L :AL,MG,TI,SI,FE,NI: !

PHASE FCC_A1 %  1  1.0  !
CONSTITUENT FCC_A1 :AL,MG,TI,SI,FE,NI: !

PHASE BCC_A2 %  1  1.0  !
CONSTITUENT BCC_A2 :AL,MG,TI,SI,FE,NI: !

PHASE HCP_A3 %  1  1.0  !
CONSTITUENT HCP_A3 :AL,MG,TI,SI,FE,NI: !

$ --- Binary Parameters ---
PARAMETER G(LIQUID,AL,TI;0) 298.15 -118000+24.5*T; 6000 N !
PARAMETER G(LIQUID,AL,TI;1) 298.15 +12000-2.0*T; 6000 N !
PARAMETER G(FCC_A1,AL,TI;0) 298.15 -112000+22.0*T; 6000 N !
PARAMETER G(BCC_A2,AL,TI;0) 298.15 -105000+21.0*T; 6000 N !
PARAMETER G(HCP_A3,AL,TI;0) 298.15 -116000+23.0*T; 6000 N !

PARAMETER G(LIQUID,AL,MG;0) 298.15 -14200+4.1*T; 6000 N !
PARAMETER G(FCC_A1,AL,MG;0) 298.15 -2500+1.2*T; 6000 N !

PARAMETER G(LIQUID,AL,SI;0) 298.15 -11200+2.5*T; 6000 N !
PARAMETER G(FCC_A1,AL,SI;0) 298.15 -8500+1.8*T; 6000 N !

PARAMETER G(LIQUID,TI,SI;0) 298.15 -195000+32.0*T; 6000 N !
PARAMETER G(BCC_A2,TI,SI;0) 298.15 -180000+30.0*T; 6000 N !

$ --- Ternary Parameters ---
PARAMETER G(LIQUID,AL,MG,SI;0) 298.15 -8500+1.5*T; 6000 N !
PARAMETER G(FCC_A1,AL,MG,SI;0) 298.15 -6200+1.0*T; 6000 N !
PARAMETER G(LIQUID,AL,TI,SI;0) 298.15 -25000+4.0*T; 6000 N !

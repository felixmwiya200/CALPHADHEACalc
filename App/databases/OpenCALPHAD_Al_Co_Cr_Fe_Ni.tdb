$ OpenCALPHAD Multicomponent TDB Database: Al-Co-Cr-Fe-Ni System
$ Source: OpenCALPHAD / NIST / Literature Assessed Thermodynamic Database
$ Compatible with OpenCALPHAD, Thermo-Calc, Pandat, and HEAThermoEngine

ELEMENT /-   ELECTRON_GAS              0.0000E+00  0.0000E+00  0.0000E+00 !
ELEMENT VA   VACUUM                    0.0000E+00  0.0000E+00  0.0000E+00 !
ELEMENT AL   FCC_A1                    2.6982E+01  4.5773E+03  2.8322E+01 !
ELEMENT CO   HCP_A3                    5.8933E+01  0.0000E+00  3.0040E+01 !
ELEMENT CR   BCC_A2                    5.1996E+01  0.0000E+00  2.3560E+01 !
ELEMENT FE   BCC_A2                    5.5847E+01  4.4890E+03  2.7280E+01 !
ELEMENT NI   FCC_A1                    5.8690E+01  4.7870E+03  2.9796E+01 !

PHASE LIQUID:L %  1  1.0  !
CONSTITUENT LIQUID:L :AL,CO,CR,FE,NI: !

PHASE FCC_A1 %  1  1.0  !
CONSTITUENT FCC_A1 :AL,CO,CR,FE,NI: !

PHASE BCC_A2 %  1  1.0  !
CONSTITUENT BCC_A2 :AL,CO,CR,FE,NI: !

$ --- Binary Interaction Parameters: LIQUID ---
PARAMETER G(LIQUID,AL,CO;0) 298.15 -135000+28.5*T; 6000 N !
PARAMETER G(LIQUID,AL,CO;1) 298.15 -32000+5.1*T; 6000 N !
PARAMETER G(LIQUID,AL,CR;0) 298.15 -39800+7.2*T; 6000 N !
PARAMETER G(LIQUID,AL,FE;0) 298.15 -76500+22.0*T; 6000 N !
PARAMETER G(LIQUID,AL,FE;1) 298.15 -31000+8.5*T; 6000 N !
PARAMETER G(LIQUID,AL,NI;0) 298.15 -148600+35.5*T; 6000 N !
PARAMETER G(LIQUID,AL,NI;1) 298.15 -35000+8.2*T; 6000 N !
PARAMETER G(LIQUID,CO,CR;0) 298.15 -18500+5.2*T; 6000 N !
PARAMETER G(LIQUID,CO,FE;0) 298.15 -9754+0.0*T; 6000 N !
PARAMETER G(LIQUID,CO,NI;0) 298.15 -1800+0.0*T; 6000 N !
PARAMETER G(LIQUID,CR,FE;0) 298.15 -17737+7.996*T; 6000 N !
PARAMETER G(LIQUID,CR,NI;0) 298.15 -21500+5.6*T; 6000 N !
PARAMETER G(LIQUID,FE,NI;0) 298.15 -16777+2.899*T; 6000 N !
PARAMETER G(LIQUID,FE,NI;1) 298.15 +10374-2.280*T; 6000 N !

$ --- Binary Interaction Parameters: FCC_A1 ---
PARAMETER G(FCC_A1,AL,CO;0) 298.15 -142000+30.2*T; 6000 N !
PARAMETER G(FCC_A1,AL,CR;0) 298.15 -42000+8.5*T; 6000 N !

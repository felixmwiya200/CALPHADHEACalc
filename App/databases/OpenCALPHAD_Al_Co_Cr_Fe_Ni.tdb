PARAMETER G(FCC_A1,FE,NI;0) 298.15 -12054+3.274*T; 6000 N !
PARAMETER G(FCC_A1,FE,NI;1) 298.15 +11082-4.451*T; 6000 N !

$ --- Binary Interaction Parameters: BCC_A2 ---
PARAMETER G(BCC_A2,AL,CO;0) 298.15 -128000+26.0*T; 6000 N !
PARAMETER G(BCC_A2,AL,CR;0) 298.15 -55000+10.5*T; 6000 N !
PARAMETER G(BCC_A2,AL,FE;0) 298.15 -85000+24.5*T; 6000 N !
